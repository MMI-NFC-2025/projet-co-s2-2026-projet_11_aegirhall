---
import { getPbImageUrl } from '../js/backend.js';

interface Props {
  record?: any;
  recordImage?: string;
  src?: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  thumb?: string;
}

const {
  record,
  recordImage,
  src: srcProp,
  alt,
  class: className = 'w-full h-full object-cover',
  width = 400,
  height = 300,
  thumb
} = Astro.props;

const src = srcProp ?? getPbImageUrl(record, recordImage, thumb ? { thumb } : {});
const altText = alt ?? record?.nom ?? '';
---
{src ? (
  <img src={src} alt={altText} width={width} height={height} class={className} loading="lazy" decoding="async" />
) : (
  <div
    class={`bg-dark-600 flex items-center justify-center ${className}`}
    style={`width:${width}px;height:${height}px`}
    aria-hidden="true"
  >
    <svg class="w-10 h-10 text-dark-400" viewBox="0 0 24 24" fill="currentColor">
      <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
    </svg>
  </div>
)}
