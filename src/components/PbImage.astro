---
import { getImageUrl } from '../js/backend.js';

const {
  record,
  recordImage,
  width = 400,
  height = 300,
} = Astro.props;

const imageURL = await getImageUrl(record, recordImage);
---

{imageURL &&
    <img
        src={imageURL}
        alt={record.nom || record.Nom || 'Image'}
        width={width}
        height={height}
        style="width: 100%; height: 100%; object-fit: cover;"
    />
}
