---
import { Image } from 'astro:assets';
import logo      from '../assets/icon/logo.svg';
import menuIcon  from '../assets/icon/menu.svg';
import closeIcon from '../assets/icon/close.svg';

const token    = Astro.cookies.get('pb_token')?.value;
const userId   = Astro.cookies.get('pb_user_id')?.value;
const userName = Astro.cookies.get('pb_user_name')?.value;
const isLoggedIn = !!(token && userId);

const currentPath = Astro.url.pathname;

const navLinks = isLoggedIn
  ? [
      { href: '/bars',       label: 'Bars'        },
      { href: '/jeux',       label: 'Jeux'        },
      { href: '/classement', label: 'Classement'  },
      { href: '/Apropos',    label: 'À Propos'    },
    ]
  : [
      { href: '/bars',     label: 'Bars'     },
      { href: '/jeux',     label: 'Jeux'     },
      { href: '/Apropos',  label: 'À Propos' },
      { href: '/contact',  label: 'Contact'  },
    ];
---
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-transparent"
>
  <div class="max-w-360 mx-auto px-4 lg:px-20 h-23 flex items-center justify-between">

    <!-- Logo -->
    <a href={isLoggedIn ? '/' : '/LandingPage'} class="flex items-center gap-3 group shrink-0">
      <Image
        src={logo}
        alt="Ægirhall"
        width={32}
        height={37}
        class="group-hover:scale-110 transition-transform duration-200"
        style="color:#C49A2C;"
      />
      <span class="font-display text-xl text-primary-400 tracking-wider hidden lg:block">
        Ægirhall
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
      {navLinks.map(link => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`relative font-heading text-sm tracking-widest uppercase px-4 py-2 rounded-md transition-colors duration-200 ${
              isActive
                ? 'text-primary-400 bg-primary-400/8'
                : 'text-neutral-400 hover:text-primary-300 hover:bg-dark-700/60'
            }`}
          >
            {link.label}
            {isActive && (
              <span class="absolute bottom-0 left-3 right-3 h-px bg-primary-400/60 rounded-full" aria-hidden="true" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Actions desktop -->
    <div class="hidden lg:flex items-center gap-3 shrink-0">
      {isLoggedIn ? (
        <div class="flex items-center gap-3">
          <a href="/profil" class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg hover:bg-dark-700/60 transition-colors group">
            <div class="w-8 h-8 rounded-full bg-dark-600 border border-primary-400/50 flex items-center justify-center font-heading text-sm text-primary-400 group-hover:border-primary-300 transition-colors shrink-0">
              {userName ? userName.charAt(0).toUpperCase() : 'V'}
            </div>
            <span class="font-heading text-sm text-neutral-300 group-hover:text-primary-300 transition-colors">
              {userName ?? 'Profil'}
            </span>
          </a>
          <a href="/session" class="btn-primary text-xs px-5 py-2">Sessions</a>
        </div>
      ) : (
        <>
          <a href="/connexion"  class="btn-outline text-xs px-5 py-2">Connexion</a>
          <a href="/inscription" class="btn-primary text-xs px-5 py-2">Rejoindre</a>
        </>
      )}
    </div>

    <!-- Hamburger mobile -->
    <button
      id="menu-btn"
      class="lg:hidden p-2 text-neutral-300 hover:text-primary-400 transition-colors"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Image src={menuIcon} alt="" width={24} height={24} class="invert" aria-hidden="true" />
    </button>
  </div>
</header>

<!-- Menu mobile (drawer) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 translate-x-full transition-transform duration-300 lg:hidden"
  aria-hidden="true"
>
  <div id="menu-overlay" class="absolute inset-0 bg-dark-900/85 backdrop-blur-sm" />

  <nav class="absolute right-0 top-0 bottom-0 w-72 bg-dark-800 border-l border-primary-400/20 flex flex-col">

    <!-- Header du drawer -->
    <div class="flex items-center justify-between px-5 py-5 border-b border-dark-700">
      <a href={isLoggedIn ? '/' : '/LandingPage'} class="flex items-center gap-2">
        <Image src={logo} alt="Ægirhall" width={24} height={28} style="color:#C49A2C;" />
        <span class="font-display text-base text-primary-400 tracking-wider">Ægirhall</span>
      </a>
      <button id="menu-close" class="p-2 text-neutral-400 hover:text-primary-400 transition-colors rounded-md hover:bg-dark-700" aria-label="Fermer le menu">
        <Image src={closeIcon} alt="" width={20} height={20} class="invert" aria-hidden="true" />
      </button>
    </div>

    <!-- Profil connecté -->
    {isLoggedIn && (
      <a href="/profil" class="flex items-center gap-3 px-5 py-4 bg-dark-700/40 border-b border-dark-700 hover:bg-dark-700 transition-colors">
        <div class="w-9 h-9 rounded-full bg-dark-600 border border-primary-400/50 flex items-center justify-center font-heading text-sm text-primary-400 shrink-0">
          {userName ? userName.charAt(0).toUpperCase() : 'V'}
        </div>
        <div>
          <p class="font-heading text-sm text-neutral-200 tracking-wide">{userName ?? 'Mon Profil'}</p>
          <p class="font-body text-xs text-neutral-500">Voir mon profil</p>
        </div>
      </a>
    )}

    <!-- Liens nav -->
    <nav class="flex flex-col gap-1 px-3 py-4 flex-1" aria-label="Navigation mobile">
      {navLinks.map(link => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`flex items-center justify-between font-heading text-sm tracking-widest uppercase px-4 py-3.5 rounded-lg transition-colors ${
              isActive
                ? 'text-primary-400 bg-primary-400/10 border border-primary-400/20'
                : 'text-neutral-300 hover:text-primary-400 hover:bg-dark-700'
            }`}
          >
            {link.label}
            {isActive && <span class="w-1.5 h-1.5 rounded-full bg-primary-400 shrink-0" aria-hidden="true" />}
          </a>
        );
      })}
    </nav>

    <!-- Actions bas du drawer -->
    <div class="px-5 py-5 border-t border-dark-700 flex flex-col gap-3">
      {isLoggedIn ? (
        <>
          <a href="/session" class="btn-primary text-sm text-center">Sessions</a>
          <form action="/profil" method="POST">
            <button type="submit" class="w-full font-heading text-xs text-neutral-500 hover:text-accent-blood tracking-widest uppercase py-2 transition-colors">
              Se déconnecter
            </button>
          </form>
        </>
      ) : (
        <>
          <a href="/connexion"   class="btn-outline text-sm text-center">Connexion</a>
          <a href="/inscription" class="btn-primary text-sm text-center">Rejoindre la Horde</a>
        </>
      )}
    </div>
  </nav>
</div>

<script>
  import '../js/header.js';
</script>
