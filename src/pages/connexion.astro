---
import Layout from '../layouts/Layout.astro';
import { authWithPassword } from '../js/backend.js';

const token = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (token && userId) return Astro.redirect('/');

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const identity = form.get('identity')?.toString() ?? '';
  const password = form.get('password')?.toString() ?? '';

  const result = await authWithPassword(identity, password);

  if (result?.token) {
    const displayName = result.record.pseudo ?? result.record.nom ?? result.record.username ?? 'Guerrier';
    Astro.cookies.set('pb_token',     result.token,     { path: '/', httpOnly: true, maxAge: 604800 });
    Astro.cookies.set('pb_user_id',   result.record.id, { path: '/', httpOnly: true, maxAge: 604800 });
    Astro.cookies.set('pb_user_name', displayName,      { path: '/', httpOnly: true, maxAge: 604800 });
    return Astro.redirect('/');
  } else {
    error = 'Identifiant ou mot de passe incorrect.';
  }
}
---
<Layout title="Connexion">
  <section class="min-h-[calc(100vh-92px)] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">

      <div class="text-center mb-10">
        <p class="font-heading text-primary-500 text-xs tracking-widest uppercase mb-3">✦ Ægirhall ✦</p>
        <h1 class="font-display text-3xl lg:text-4xl text-neutral-100 tracking-widest mb-3">Connexion</h1>
        <p class="font-body text-neutral-500 text-base">Entrez, guerrier. Votre horde vous attend.</p>
      </div>

      <div class="card-parchment rounded-lg p-6 lg:p-8">
        {error && (
          <div class="mb-6 p-3 rounded bg-accent-blood/20 border border-accent-blood/50 text-sm font-body text-neutral-300">
            {error}
          </div>
        )}

        <form method="POST" class="flex flex-col gap-5">
          <div>
            <label class="label-viking" for="identity">Email</label>
            <input
              id="identity"
              name="identity"
              type="email"
              autocomplete="email"
              required
              placeholder="votre@email.com"
              class="input-viking"
            />
          </div>

          <div>
            <label class="label-viking" for="password">Mot de passe</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="••••••••"
              class="input-viking"
            />
          </div>

          <button type="submit" class="btn-primary w-full mt-2 py-4">
            Entrer dans la Halle
          </button>
        </form>

        <div class="rune-divider mt-6 mb-5 text-dark-600 text-xs">ou</div>

        <p class="text-center font-body text-neutral-500 text-base">
          Pas encore de compte ?{' '}
          <a href="/inscription" class="text-primary-400 hover:text-primary-300 transition-colors">
            Rejoindre la Horde
          </a>
        </p>
      </div>

    </div>
  </section>
</Layout>
