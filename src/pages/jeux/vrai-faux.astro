---
import Layout from '../../layouts/Layout.astro';
import { PB_BASE_URL } from '../../../backend/backend.js';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');
---
<Layout title="Vrai ou Faux — AEgirhall">

  <!-- ── HEADER ───────────────────────────────────────────── -->
  <section class="bg-dark-900 border-b border-dark-700 py-8 lg:py-10">
    <div class="max-w-360 mx-auto px-4 lg:px-20">
      <a href="/jeux" class="font-heading text-xs text-neutral-600 hover:text-neutral-400 tracking-widest uppercase transition-colors">
        ← Tous les jeux
      </a>
      <div class="mt-4">
        <p class="font-heading text-xs text-primary-500 tracking-widest uppercase mb-2">Jeu de rapidité</p>
        <h1 class="font-display text-3xl lg:text-5xl text-neutral-100 tracking-widest">Vrai ou Faux</h1>
        <p class="font-body text-neutral-400 text-base mt-2 max-w-xl">
          Une équation s'affiche avec un résultat. Vrai ou faux ? Cliquez le plus vite possible — 30 secondes.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CONTENU ───────────────────────────────────────────── -->
  <section class="max-w-360 mx-auto px-4 lg:px-20 py-8 lg:py-12">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start">

      <!-- ── Colonne gauche ── -->
      <div class="w-full lg:w-72 shrink-0 flex flex-col gap-5">

        <!-- Progression -->
        <div class="card-parchment rounded-xl p-5">
          <p class="label-viking mb-4">Niveaux & XP</p>
          <div class="flex flex-col gap-1.5">
            {([
              { level: 1, range: '1–4 bons',  ops: '+ − (1-10)',        xp: 5  },
              { level: 2, range: '5–8 bons',  ops: '+ − × (1-20)',      xp: 10 },
              { level: 3, range: '9–13 bons', ops: '+ − × ÷ (1-50)',    xp: 15 },
              { level: 4, range: '14+ bons',  ops: 'Calculs composés',  xp: 25 },
            ] as const).map(row => (
              <div class="flex items-center gap-3 p-2.5 rounded-lg bg-dark-700 border border-dark-600">
                <div class="w-7 h-7 rounded-full bg-primary-400/20 border border-primary-400/40 flex items-center justify-center shrink-0">
                  <span class="font-heading text-xs text-primary-300">{row.level}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-heading text-xs text-neutral-300 tracking-wide">{row.range}</p>
                  <p class="font-body text-xs text-neutral-600">{row.ops}</p>
                </div>
                <span class="font-display text-xs text-primary-300 shrink-0">+{row.xp} XP</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Règles -->
        <div class="card-parchment rounded-xl p-5">
          <p class="label-viking mb-3">Règles</p>
          <ul class="flex flex-col gap-2.5">
            {[
              'Une équation avec un résultat s\'affiche',
              'Cliquez VRAI si le résultat est correct',
              'Cliquez FAUX s\'il est incorrect',
              'Bonne réponse = XP + question suivante',
              'Mauvaise réponse = question suivante sans XP',
            ].map(t => (
              <li class="flex items-start gap-2.5">
                <span class="text-primary-300 text-xs mt-0.5 shrink-0">▸</span>
                <span class="font-body text-xs text-neutral-400">{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Total session -->
        <div id="session-total" class="hidden card-parchment rounded-xl p-5">
          <p class="label-viking mb-2">Session en cours</p>
          <div class="flex items-center justify-between">
            <span class="font-body text-sm text-neutral-500">XP gagné</span>
            <span id="total-xp-val" class="font-display text-xl text-primary-300">0 XP</span>
          </div>
        </div>
      </div>

      <!-- ── Colonne droite : jeu ── -->
      <div class="flex-1 card-parchment rounded-2xl overflow-hidden flex flex-col">

        <!-- État initial -->
        <div id="start-wrap" class="flex flex-col items-center justify-center gap-6 p-12 lg:p-16">
          <div class="flex items-center gap-4 select-none" aria-hidden="true">
            <span class="font-display text-2xl text-accent-rune opacity-60">✓</span>
            <span class="font-display text-3xl text-neutral-600">7 × 8 = 56</span>
            <span class="font-display text-2xl text-accent-blood opacity-60">✗</span>
          </div>
          <p class="font-body text-neutral-400 text-center max-w-xs">
            Vrai ou Faux ? <strong class="text-neutral-200">30 secondes</strong>, autant de questions que possible.
          </p>
          <button id="start-btn" class="btn-primary px-10 py-3 text-sm">
            ⚔ Lancer le défi
          </button>
        </div>

        <!-- Zone de jeu -->
        <div id="game-area" class="hidden flex-col">

          <!-- Timer bar -->
          <div class="h-2 bg-dark-700 w-full">
            <div id="timer-bar" class="h-full transition-none" style="width:100%;background-color:#2D6A4F;"></div>
          </div>

          <!-- Stats -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-dark-600 bg-dark-700/40">
            <div class="flex items-center gap-4">
              <div class="flex flex-col">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Bons</span>
                <span id="score-display" class="font-display text-2xl text-primary-300 leading-none">0</span>
              </div>
              <div class="w-px h-8 bg-dark-600" />
              <div class="flex flex-col">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">XP</span>
                <span id="live-xp" class="font-display text-2xl text-primary-300 leading-none">0</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span id="level-badge" class="px-3 py-1 rounded-full font-heading text-xs tracking-widest uppercase bg-primary-400/10 border border-primary-400/30 text-primary-400">Niv. 1</span>
              <div class="flex flex-col items-end">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Temps</span>
                <span id="timer-text" class="font-display text-2xl text-neutral-200 leading-none">30s</span>
              </div>
            </div>
          </div>

          <!-- Question -->
          <div class="flex-1 flex flex-col items-center justify-center gap-8 px-6 py-10 lg:py-14">
            <p id="question-display"
               class="font-display text-3xl lg:text-5xl text-neutral-100 tracking-wide text-center select-none transition-colors duration-150"
               aria-live="polite">
            </p>

            <!-- Boutons Vrai / Faux -->
            <div class="flex gap-4 w-full max-w-sm">
              <button id="btn-vrai"
                class="flex-1 py-5 rounded-xl font-heading text-lg tracking-widest uppercase transition-all duration-150 border-2"
                style="background:#15803d22;border-color:#15803d66;color:#16a34a;"
                aria-label="Vrai">
                ✓ Vrai
              </button>
              <button id="btn-faux"
                class="flex-1 py-5 rounded-xl font-heading text-lg tracking-widest uppercase transition-all duration-150 border-2"
                style="background:#8C1C1322;border-color:#8C1C1366;color:#ef4444;"
                aria-label="Faux">
                ✗ Faux
              </button>
            </div>
          </div>
        </div>

        <!-- Résultat -->
        <div id="game-result" class="hidden flex-col items-center gap-5 p-10 lg:p-14 text-center">
          <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Temps écoulé !</p>
          <div class="flex items-baseline gap-3">
            <span id="res-score" class="font-display text-7xl text-primary-300">0</span>
            <span class="font-heading text-lg text-neutral-500 tracking-wide">bonnes réponses</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex flex-col items-center px-4 py-2 rounded-lg bg-dark-700 border border-dark-600">
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-1">Niveau atteint</span>
              <span id="res-level" class="font-display text-lg text-primary-400">1</span>
            </div>
            <div class="flex flex-col items-center px-4 py-2 rounded-lg bg-primary-400/10 border border-primary-400/30">
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-1">XP gagné</span>
              <span id="res-xp" class="font-display text-lg text-primary-300">+0 XP</span>
            </div>
          </div>
          <button id="replay-btn" class="btn-primary px-8 py-3 text-sm mt-2">⟳ Rejouer</button>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  #btn-vrai:hover { background: #15803d55 !important; border-color: #16a34a !important; transform: translateY(-2px); }
  #btn-faux:hover { background: #8C1C1355 !important; border-color: #ef4444 !important; transform: translateY(-2px); }
  #btn-vrai:active, #btn-faux:active { transform: translateY(0); }
  #btn-vrai.flash-ok, #btn-faux.flash-ok { background: #15803d88 !important; border-color: #16a34a !important; }
  #btn-vrai.flash-fail, #btn-faux.flash-fail { background: #8C1C1388 !important; border-color: #ef4444 !important; }
</style>

<script define:vars={{ _token: token, _userId: userId, _pbUrl: PB_BASE_URL }} is:inline>
(function() {
  var TIME_LIMIT = 30;
  var score = 0, totalXp = 0, sessionXp = 0;
  var phase = 'idle';
  var currentIsTrue = false, currentXp = 0;
  var timerRAF = null, startTime = 0;
  var waiting = false;

  var startWrap   = document.getElementById('start-wrap');
  var startBtn    = document.getElementById('start-btn');
  var gameArea    = document.getElementById('game-area');
  var resultEl    = document.getElementById('game-result');
  var questionEl  = document.getElementById('question-display');
  var btnVrai     = document.getElementById('btn-vrai');
  var btnFaux     = document.getElementById('btn-faux');
  var timerBar    = document.getElementById('timer-bar');
  var timerText   = document.getElementById('timer-text');
  var scoreEl     = document.getElementById('score-display');
  var liveXpEl    = document.getElementById('live-xp');
  var levelBadge  = document.getElementById('level-badge');
  var resScore    = document.getElementById('res-score');
  var resXp       = document.getElementById('res-xp');
  var resLevel    = document.getElementById('res-level');
  var replayBtn   = document.getElementById('replay-btn');
  var totalWrap   = document.getElementById('session-total');
  var totalVal    = document.getElementById('total-xp-val');

  function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }

  function getLevel(n) {
    if (n < 4)  return 1;
    if (n < 8)  return 2;
    if (n < 13) return 3;
    return 4;
  }
  function xpForLevel(l) { return [0,5,10,15,25][Math.min(l,4)]; }

  function generateQuestion(level) {
    var a, b, c, correct, display, op, question;

    if (level <= 1) {
      a = rand(1,10); b = rand(1,10);
      op = rand(0,1) ? '+' : '−';
      correct = op === '+' ? a+b : Math.abs(a-b);
      if (op === '−' && a < b) { c=a; a=b; b=c; }
      question = a + ' ' + op + ' ' + b;
    } else if (level === 2) {
      var t2 = rand(0,2);
      if (t2 === 0) { a=rand(5,20); b=rand(5,20); question=a+' + '+b; correct=a+b; }
      else if (t2 === 1) { a=rand(10,30); b=rand(1,a-1); question=a+' − '+b; correct=a-b; }
      else { a=rand(2,9); b=rand(2,9); question=a+' × '+b; correct=a*b; }
    } else if (level === 3) {
      var t3 = rand(0,3);
      if (t3 === 0) { a=rand(10,50); b=rand(10,50); question=a+' + '+b; correct=a+b; }
      else if (t3 === 1) { a=rand(20,80); b=rand(5,a-1); question=a+' − '+b; correct=a-b; }
      else if (t3 === 2) { a=rand(3,12); b=rand(3,12); question=a+' × '+b; correct=a*b; }
      else { b=rand(2,9); correct=rand(2,10); a=b*correct; question=a+' ÷ '+b; }
    } else {
      var t4 = rand(0,1);
      if (t4 === 0) { a=rand(3,12); b=rand(3,12); c=rand(1,20); question=a+' × '+b+' + '+c; correct=a*b+c; }
      else { a=rand(3,12); b=rand(3,12); c=rand(1,20); correct=a*b-c; if(correct<0)correct=-correct; question=a+' × '+b+' − '+c; }
    }

    var isTrue = Math.random() > 0.45;
    if (!isTrue) {
      var spread = Math.max(2, Math.round(Math.abs(correct) * 0.15));
      var offset = rand(1, spread) * (rand(0,1) ? 1 : -1);
      if (offset === 0) offset = 1;
      display = correct + offset;
    } else {
      display = correct;
    }

    return { question: question + ' = ' + display, isTrue: isTrue, xp: xpForLevel(level) };
  }

  function tickTimer() {
    var elapsed = (Date.now() - startTime) / 1000;
    var left    = Math.max(0, TIME_LIMIT - elapsed);
    var pct     = (left / TIME_LIMIT) * 100;
    timerBar.style.width = pct + '%';
    timerBar.style.backgroundColor = pct > 60 ? '#2D6A4F' : pct > 30 ? '#94701C' : '#8C1C13';
    timerText.textContent = Math.ceil(left) + 's';
    if (left <= 0) { endGame(); return; }
    timerRAF = requestAnimationFrame(tickTimer);
  }

  function startGame() {
    score=0; totalXp=0; phase='playing'; waiting=false;
    startWrap.classList.add('hidden');
    gameArea.classList.remove('hidden'); gameArea.classList.add('flex');
    resultEl.classList.add('hidden'); resultEl.classList.remove('flex');
    nextQuestion();
    startTime = Date.now();
    timerRAF = requestAnimationFrame(tickTimer);
  }

  function nextQuestion() {
    var lvl = getLevel(score);
    var q   = generateQuestion(lvl);
    currentIsTrue = q.isTrue;
    currentXp     = q.xp;
    questionEl.textContent = q.question;
    questionEl.style.color = '';
    levelBadge.textContent = 'Niv. ' + lvl;
    scoreEl.textContent    = score;
    liveXpEl.textContent   = totalXp + ' XP';
  }

  function checkAnswer(playerSaysTrue) {
    if (phase !== 'playing' || waiting) return;
    waiting = true;

    var correct = (playerSaysTrue === currentIsTrue);
    if (correct) {
      score++; totalXp += currentXp;
      questionEl.style.color = '#16a34a';
      (playerSaysTrue ? btnVrai : btnFaux).classList.add('flash-ok');
    } else {
      questionEl.style.color = '#ef4444';
      (playerSaysTrue ? btnVrai : btnFaux).classList.add('flash-fail');
    }

    setTimeout(function() {
      btnVrai.classList.remove('flash-ok','flash-fail');
      btnFaux.classList.remove('flash-ok','flash-fail');
      waiting = false;
      nextQuestion();
    }, 350);
  }

  function endGame() {
    if (phase !== 'playing') return;
    phase = 'done';
    cancelAnimationFrame(timerRAF);
    gameArea.classList.add('hidden'); gameArea.classList.remove('flex');
    resultEl.classList.remove('hidden'); resultEl.classList.add('flex');
    resScore.textContent = score;
    resXp.textContent    = '+' + totalXp + ' XP';
    resLevel.textContent = 'Niveau ' + getLevel(score);
    sessionXp += totalXp;
    if (totalWrap) { totalWrap.classList.remove('hidden'); totalVal.textContent = sessionXp + ' XP'; }
    if (totalXp > 0) saveXp(totalXp);
  }

  function saveXp(xp) {
    fetch(_pbUrl + '/api/collections/users/records/' + _userId, { headers: { 'Authorization': 'Bearer ' + _token } })
    .then(function(r){ return r.json(); })
    .then(function(u){ return fetch(_pbUrl+'/api/collections/users/records/'+_userId, { method:'PATCH', headers:{'Content-Type':'application/json','Authorization':'Bearer '+_token}, body: JSON.stringify({xp: Number(u.xp||0)+xp}) }); })
    .catch(function(){});
  }

  startBtn  && startBtn.addEventListener('click',  startGame);
  replayBtn && replayBtn.addEventListener('click', startGame);
  btnVrai   && btnVrai.addEventListener('click',   function(){ checkAnswer(true);  });
  btnFaux   && btnFaux.addEventListener('click',   function(){ checkAnswer(false); });

  document.addEventListener('keydown', function(e) {
    if (phase !== 'playing') return;
    if (e.key === 'ArrowLeft'  || e.key === 'v' || e.key === 'V') checkAnswer(true);
    if (e.key === 'ArrowRight' || e.key === 'f' || e.key === 'F') checkAnswer(false);
  });
})();
</script>