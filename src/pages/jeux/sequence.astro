---
import Layout from '../../layouts/Layout.astro';
import { PB_BASE_URL } from '../../js/backend.js';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');
---
<Layout title="Séquence Viking — AEgirhall">

  <!-- ── HEADER ───────────────────────────────────────────── -->
  <section class="bg-dark-900 border-b border-dark-700 py-8 lg:py-10">
    <div class="max-w-360 mx-auto px-4 lg:px-20">
      <a href="/jeux" class="font-heading text-xs text-neutral-600 hover:text-neutral-400 tracking-widest uppercase transition-colors">
        ← Tous les jeux
      </a>
      <div class="mt-4">
        <p class="font-heading text-xs text-primary-500 tracking-widest uppercase mb-2">Jeu de mémoire</p>
        <h1 class="font-display text-3xl lg:text-5xl text-neutral-100 tracking-widest">Séquence Viking</h1>
        <p class="font-body text-neutral-400 text-base mt-2 max-w-xl">
          Les runes s'allument dans un ordre précis. Mémorisez, puis reproduisez la séquence. Chaque round ajoute une rune.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CONTENU ───────────────────────────────────────────── -->
  <section class="max-w-360 mx-auto px-4 lg:px-20 py-8 lg:py-12">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start">

      <!-- ── Colonne gauche ── -->
      <div class="w-full lg:w-72 shrink-0 flex flex-col gap-5">

        <!-- Tableau XP -->
        <div class="card-parchment rounded-xl p-5">
          <p class="label-viking mb-4">XP par round</p>
          <div class="flex flex-col gap-1.5">
            {([
              { range: 'Round 1–2', seq: '3–4 runes', xp: 20  },
              { range: 'Round 3–4', seq: '5–6 runes', xp: 40  },
              { range: 'Round 5–6', seq: '7–8 runes', xp: 70  },
              { range: 'Round 7+',  seq: '9+ runes',  xp: 100 },
            ] as const).map(row => (
              <div class="flex items-center gap-3 p-2.5 rounded-lg bg-dark-700 border border-dark-600">
                <div class="flex-1 min-w-0">
                  <p class="font-heading text-xs text-neutral-300 tracking-wide">{row.range}</p>
                  <p class="font-body text-xs text-neutral-600">{row.seq}</p>
                </div>
                <span class="font-display text-xs text-primary-300 shrink-0">+{row.xp} XP</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Règles -->
        <div class="card-parchment rounded-xl p-5">
          <p class="label-viking mb-3">Règles</p>
          <ul class="flex flex-col gap-2.5">
            {[
              'Les runes s\'allument une par une',
              'Mémorisez l\'ordre exact',
              'Reproduisez la séquence en cliquant',
              'Une erreur = fin de partie',
              'Chaque round réussi ajoute une rune',
            ].map(t => (
              <li class="flex items-start gap-2.5">
                <span class="text-primary-300 text-xs mt-0.5 shrink-0">▸</span>
                <span class="font-body text-xs text-neutral-400">{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Total session -->
        <div id="session-total" class="hidden card-parchment rounded-xl p-5">
          <p class="label-viking mb-2">Session en cours</p>
          <div class="flex items-center justify-between">
            <span class="font-body text-sm text-neutral-500">XP gagné</span>
            <span id="total-xp-val" class="font-display text-xl text-primary-300">0 XP</span>
          </div>
        </div>
      </div>

      <!-- ── Colonne droite : jeu ── -->
      <div class="flex-1 card-parchment rounded-2xl overflow-hidden flex flex-col">

        <!-- État initial -->
        <div id="start-wrap" class="flex flex-col items-center justify-center gap-6 p-12 lg:p-16">
          <div class="grid grid-cols-3 gap-3 select-none" aria-hidden="true">
            {['#dc2626','#2563eb','#16a34a','#ca8a04','#9333ea','#0891b2'].map(c => (
              <div class="w-12 h-12 rounded-full opacity-30" style={`background:${c}`} />
            ))}
          </div>
          <p class="font-body text-neutral-400 text-center max-w-xs">
            Regardez les runes s'allumer, puis reproduisez l'ordre exact de mémoire.
          </p>
          <button id="start-btn" class="btn-primary px-10 py-3 text-sm">
            ⚔ Commencer
          </button>
        </div>

        <!-- Zone de jeu -->
        <div id="game-area" class="hidden flex-col">

          <!-- Infos round -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-dark-600 bg-dark-700/40">
            <div class="flex items-center gap-4">
              <div class="flex flex-col">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Round</span>
                <span id="round-display" class="font-display text-2xl text-primary-300 leading-none">1</span>
              </div>
              <div class="w-px h-8 bg-dark-600" />
              <div class="flex flex-col">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">XP accumulé</span>
                <span id="live-xp" class="font-display text-2xl text-primary-300 leading-none">0</span>
              </div>
            </div>
            <div class="flex flex-col items-end">
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Séquence</span>
              <span id="seq-length" class="font-display text-2xl text-neutral-200 leading-none">3</span>
            </div>
          </div>

          <!-- Statut -->
          <p id="game-status" class="font-heading text-xs text-neutral-500 tracking-widest uppercase text-center pt-5 px-4"
             aria-live="polite">
            Regardez la séquence...
          </p>

          <!-- Grille des runes -->
          <div class="flex items-center justify-center p-8 lg:p-12">
            <div class="grid grid-cols-3 gap-4 lg:gap-5" id="rune-grid">
              {[0,1,2,3,4,5].map(i => (
                <button
                  class="rune-btn w-20 h-20 lg:w-24 lg:h-24 rounded-2xl border-2 border-dark-500 bg-dark-700 transition-all duration-150 disabled:cursor-not-allowed"
                  data-idx={i}
                  disabled
                  aria-label={`Rune ${i+1}`}
                />
              ))}
            </div>
          </div>

          <!-- Progression de la saisie -->
          <div class="flex justify-center gap-2 pb-8" id="progress-dots" aria-hidden="true"></div>
        </div>

        <!-- Résultat -->
        <div id="game-result" class="hidden flex-col items-center gap-5 p-10 lg:p-14 text-center">
          <p id="res-title" class="font-heading text-xs tracking-widest uppercase"></p>
          <div class="flex items-baseline gap-3">
            <span id="res-round" class="font-display text-7xl text-primary-300">0</span>
            <span class="font-heading text-lg text-neutral-500 tracking-wide">rounds réussis</span>
          </div>
          <div class="flex flex-col items-center px-6 py-3 rounded-xl bg-primary-400/10 border border-primary-400/30">
            <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-1">XP gagné</span>
            <span id="res-xp" class="font-display text-2xl text-primary-300">+0 XP</span>
          </div>
          <button id="replay-btn" class="btn-primary px-8 py-3 text-sm mt-2">⟳ Rejouer</button>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  .rune-btn.lit {
    transform: scale(1.08);
    box-shadow: 0 0 24px 4px currentColor;
    border-color: currentColor;
  }
  .rune-btn.correct-flash {
    transform: scale(1.05);
    opacity: 0.9;
  }
  .rune-btn.wrong-flash {
    animation: wrong-shake 0.35s ease;
    filter: brightness(1.5);
  }
  @keyframes wrong-shake {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-8px); }
    40%     { transform: translateX(8px); }
    60%     { transform: translateX(-5px); }
    80%     { transform: translateX(5px); }
  }
</style>

<script define:vars={{ _token: token, _userId: userId, _pbUrl: PB_BASE_URL }} is:inline>
(function() {
  var COLORS = ['#dc2626','#2563eb','#16a34a','#ca8a04','#9333ea','#0891b2'];
  var COLORS_DIM = ['#3b0a0a','#0a1a3b','#0a1f0a','#3b2a0a','#1e0a3b','#0a1e2a'];

  var sequence   = [];
  var playerSeq  = [];
  var round      = 0;
  var totalXp    = 0;
  var sessionXp  = 0;
  var phase      = 'idle';

  var startWrap    = document.getElementById('start-wrap');
  var startBtn     = document.getElementById('start-btn');
  var gameArea     = document.getElementById('game-area');
  var resultEl     = document.getElementById('game-result');
  var statusEl     = document.getElementById('game-status');
  var roundDisp    = document.getElementById('round-display');
  var liveXpEl     = document.getElementById('live-xp');
  var seqLenEl     = document.getElementById('seq-length');
  var progressDots = document.getElementById('progress-dots');
  var resRound     = document.getElementById('res-round');
  var resXp        = document.getElementById('res-xp');
  var resTitle     = document.getElementById('res-title');
  var replayBtn    = document.getElementById('replay-btn');
  var totalWrap    = document.getElementById('session-total');
  var totalVal     = document.getElementById('total-xp-val');
  var runeBtns     = Array.from(document.querySelectorAll('.rune-btn'));

  function xpForRound(r) {
    if (r <= 2) return 20;
    if (r <= 4) return 40;
    if (r <= 6) return 70;
    return 100;
  }

  /* ── Init boutons ── */
  runeBtns.forEach(function(btn, i) {
    btn.style.backgroundColor = COLORS_DIM[i];
    btn.style.color = COLORS[i];
    btn.addEventListener('click', function() { onRuneClick(i); });
  });

  /* ── Démarrage ── */
  function startGame() {
    sequence=[]; playerSeq=[]; round=0; totalXp=0; phase='playing';
    startWrap.classList.add('hidden');
    gameArea.classList.remove('hidden'); gameArea.classList.add('flex');
    resultEl.classList.add('hidden'); resultEl.classList.remove('flex');
    nextRound();
  }

  function nextRound() {
    round++;
    playerSeq = [];
    sequence.push(Math.floor(Math.random() * 6));
    roundDisp.textContent = round;
    seqLenEl.textContent  = sequence.length;
    liveXpEl.textContent  = totalXp + ' XP';
    buildProgressDots();
    disableBtns();
    statusEl.textContent = 'Regardez la séquence...';
    showSequence(0);
  }

  function showSequence(i) {
    if (i >= sequence.length) {
      setTimeout(enableBtns, 400);
      statusEl.textContent = 'À vous ! Reproduisez la séquence';
      return;
    }
    var idx = sequence[i];
    lightOn(idx);
    setTimeout(function() {
      lightOff(idx);
      setTimeout(function() { showSequence(i + 1); }, 200);
    }, 650);
  }

  function lightOn(idx) {
    var btn = runeBtns[idx];
    btn.style.backgroundColor = COLORS[idx];
    btn.style.boxShadow = '0 0 28px 6px ' + COLORS[idx] + '88';
    btn.classList.add('lit');
  }
  function lightOff(idx) {
    var btn = runeBtns[idx];
    btn.style.backgroundColor = COLORS_DIM[idx];
    btn.style.boxShadow = '';
    btn.classList.remove('lit');
  }

  function enableBtns()  { runeBtns.forEach(function(b){ b.disabled = false; }); }
  function disableBtns() { runeBtns.forEach(function(b){ b.disabled = true; }); }

  function onRuneClick(idx) {
    if (phase !== 'playing') return;
    var pos = playerSeq.length;
    playerSeq.push(idx);

    lightOn(idx);
    setTimeout(function() { lightOff(idx); }, 300);

    /* Bonne rune */
    if (idx === sequence[pos]) {
      updateProgressDot(pos, true);
      if (playerSeq.length === sequence.length) {
        disableBtns();
        totalXp += xpForRound(round);
        liveXpEl.textContent = totalXp + ' XP';
        statusEl.textContent = '✓ Séquence correcte !';
        setTimeout(nextRound, 900);
      }
    } else {
      /* Mauvaise rune */
      disableBtns();
      updateProgressDot(pos, false);
      runeBtns[idx].classList.add('wrong-flash');
      setTimeout(function() { runeBtns[idx].classList.remove('wrong-flash'); }, 400);
      statusEl.textContent = '✗ Erreur ! La bonne rune était la ' + (sequence[pos]+1);
      /* Flash correct */
      setTimeout(function() {
        lightOn(sequence[pos]);
        setTimeout(function() { lightOff(sequence[pos]); endGame(); }, 600);
      }, 500);
    }
  }

  function buildProgressDots() {
    progressDots.innerHTML = '';
    for (var i = 0; i < sequence.length; i++) {
      var dot = document.createElement('span');
      dot.className = 'w-2 h-2 rounded-full bg-dark-500 transition-colors duration-200';
      dot.id = 'dot-' + i;
      progressDots.appendChild(dot);
    }
  }
  function updateProgressDot(pos, ok) {
    var dot = document.getElementById('dot-' + pos);
    if (dot) dot.style.backgroundColor = ok ? '#16a34a' : '#8C1C13';
  }

  function endGame() {
    phase = 'done';
    var completedRounds = round - 1;
    gameArea.classList.add('hidden'); gameArea.classList.remove('flex');
    resultEl.classList.remove('hidden'); resultEl.classList.add('flex');
    resTitle.textContent = completedRounds > 0 ? 'Bien joué !' : 'Pas de chance…';
    resTitle.style.color = completedRounds > 0 ? '#16a34a' : '#8C1C13';
    resRound.textContent = completedRounds;
    resXp.textContent    = '+' + totalXp + ' XP';
    sessionXp += totalXp;
    if (totalWrap) { totalWrap.classList.remove('hidden'); totalVal.textContent = sessionXp + ' XP'; }
    if (totalXp > 0) saveXp(totalXp);
  }

  function saveXp(xp) {
    fetch(_pbUrl + '/api/collections/users/records/' + _userId, { headers: { 'Authorization': 'Bearer ' + _token } })
    .then(function(r){ return r.json(); })
    .then(function(u){ return fetch(_pbUrl+'/api/collections/users/records/'+_userId, { method:'PATCH', headers:{'Content-Type':'application/json','Authorization':'Bearer '+_token}, body: JSON.stringify({xp: Number(u.xp||0)+xp}) }); })
    .catch(function(){});
  }

  startBtn  && startBtn.addEventListener('click',  startGame);
  replayBtn && replayBtn.addEventListener('click', startGame);
})();
</script>
