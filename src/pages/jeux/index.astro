---
import Layout from '../../layouts/Layout.astro';
import PbImage from '../../components/PbImage.astro';
import HeroSection from '../../components/HeroSection.astro';
import { getCollection } from '../../js/backend.js';
import StatusBadge from '../../components/StatusBadge.astro';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

const jeux = await getCollection('jeux', { sort: 'nom', token });
---
<Layout title="Les Jeux">

  <HeroSection title="Les Jeux" subtitle="Défis et tournois pour les guerriers" />

  <section class="max-w-360 mx-auto px-4 lg:px-20 py-10 lg:py-14">

    {jeux.length === 0 && (
      <div class="card-parchment rounded-lg p-10 text-center">
        <p class="font-body text-neutral-500 text-lg">Aucun jeu disponible pour l'instant.</p>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- ── Jeu statique : Touche du Guerrier ── -->
      <a href="/jeux/reflexes" class="card-parchment rounded-lg overflow-hidden flex flex-col group hover:border-primary-400/40 transition-colors">
        <!-- Visuel -->
        <div class="h-48 bg-dark-900 flex items-center justify-center relative overflow-hidden">
          <div class="flex gap-6 items-center select-none" aria-hidden="true">
            <span class="text-6xl opacity-30" style="color:var(--color-accent-blood)">◉</span>
            <span class="font-heading text-2xl text-neutral-600 tracking-widest">→</span>
            <span class="text-6xl opacity-30" style="color:#16a34a">◉</span>
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-dark-800/80 to-transparent pointer-events-none" />
          <div class="absolute top-3 right-3 px-2 py-1 rounded font-heading text-xs tracking-widest uppercase bg-primary-500/20 border border-primary-500/40 text-primary-300">
            Réflexes
          </div>
        </div>
        <!-- Contenu -->
        <div class="p-5 lg:p-6 flex flex-col gap-3 flex-1">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-heading text-lg text-neutral-200 tracking-wide group-hover:text-primary-300 transition-colors">
              Touche du Guerrier
            </h3>
            <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase shrink-0 mt-1">Jeu en ligne</span>
          </div>
          <div class="flex items-center gap-3 flex-wrap">
            <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">Difficulté</span>
            <div class="flex gap-1.5 items-center">
              <span class="px-2 py-0.5 rounded-full text-xs font-heading tracking-wide border border-accent-rune/50 text-accent-rune">Facile</span>
              <span class="px-2 py-0.5 rounded-full text-xs font-heading tracking-wide border border-primary-500/50 text-primary-400">Moyen</span>
              <span class="px-2 py-0.5 rounded-full text-xs font-heading tracking-wide border border-accent-blood/50 text-accent-blood">Difficile</span>
            </div>
          </div>
          <p class="font-body text-neutral-400 text-base line-clamp-3">
            Rouge : attendez. Vert : cliquez ! Testez votre temps de réaction et gagnez jusqu'à 200 XP par manche.
          </p>
          <div class="mt-auto pt-2 flex items-center gap-2 text-neutral-600 group-hover:text-primary-400 transition-colors" aria-hidden="true">
            <span class="font-heading text-xs tracking-widest uppercase">Jouer maintenant</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      <!-- ── Jeu statique : Calculs du Jarl ── -->
      <a href="/jeux/calculs" class="card-parchment rounded-lg overflow-hidden flex flex-col group hover:border-primary-400/40 transition-colors">
        <!-- Visuel -->
        <div class="h-48 bg-dark-900 flex items-center justify-center relative overflow-hidden">
          <div class="flex flex-col items-center gap-1 select-none" aria-hidden="true">
            <span class="font-display text-3xl text-neutral-600 opacity-60">7 × 8 + 3</span>
            <span class="font-display text-xl text-primary-400 opacity-40">= ?</span>
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-dark-800/80 to-transparent pointer-events-none" />
          <div class="absolute top-3 right-3 px-2 py-1 rounded font-heading text-xs tracking-widest uppercase bg-primary-500/20 border border-primary-500/40 text-primary-300">
            Calcul mental
          </div>
        </div>
        <!-- Contenu -->
        <div class="p-5 lg:p-6 flex flex-col gap-3 flex-1">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-heading text-lg text-neutral-200 tracking-wide group-hover:text-primary-300 transition-colors">
              Calculs du Jarl
            </h3>
            <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase shrink-0 mt-1">Jeu en ligne</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">Durée</span>
            <span class="font-heading text-xs text-primary-400">30 secondes</span>
            <span class="text-neutral-600">·</span>
            <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">XP</span>
            <span class="font-heading text-xs text-primary-400">jusqu'à 30 XP / calcul</span>
          </div>
          <p class="font-body text-neutral-400 text-base line-clamp-3">
            Maximum de calculs en 10 secondes. Plus vous en réussissez, plus ils deviennent difficiles — et plus vous rapportez d'XP.
          </p>
          <div class="mt-auto pt-2 flex items-center gap-2 text-neutral-600 group-hover:text-primary-400 transition-colors" aria-hidden="true">
            <span class="font-heading text-xs tracking-widest uppercase">Jouer maintenant</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      <!-- ── Jeu statique : Vrai ou Faux ── -->
      <a href="/jeux/vrai-faux" class="card-parchment rounded-lg overflow-hidden flex flex-col group hover:border-primary-400/40 transition-colors">
        <div class="h-48 bg-dark-900 flex items-center justify-center relative overflow-hidden">
          <div class="flex items-center gap-6 select-none" aria-hidden="true">
            <div class="flex flex-col items-center gap-1">
              <span class="font-display text-2xl opacity-50" style="color:#16a34a">✓</span>
              <span class="font-heading text-xs tracking-widest uppercase opacity-40" style="color:#16a34a">Vrai</span>
            </div>
            <span class="font-display text-3xl text-neutral-600 opacity-40">7×8 = 54</span>
            <div class="flex flex-col items-center gap-1">
              <span class="font-display text-2xl opacity-50" style="color:#ef4444">✗</span>
              <span class="font-heading text-xs tracking-widest uppercase opacity-40" style="color:#ef4444">Faux</span>
            </div>
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-dark-800/80 to-transparent pointer-events-none" />
          <div class="absolute top-3 right-3 px-2 py-1 rounded font-heading text-xs tracking-widest uppercase bg-primary-500/20 border border-primary-500/40 text-primary-300">
            Rapidité
          </div>
        </div>
        <div class="p-5 lg:p-6 flex flex-col gap-3 flex-1">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-heading text-lg text-neutral-200 tracking-wide group-hover:text-primary-300 transition-colors">Vrai ou Faux</h3>
            <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase shrink-0 mt-1">Jeu en ligne</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">Durée</span>
            <span class="font-heading text-xs text-primary-400">30 secondes</span>
            <span class="text-neutral-600">·</span>
            <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">XP</span>
            <span class="font-heading text-xs text-primary-400">jusqu'à 25 XP / bonne réponse</span>
          </div>
          <p class="font-body text-neutral-400 text-base line-clamp-3">Une équation s'affiche avec un résultat. Vrai ou faux ? Décidez le plus vite possible en 30 secondes.</p>
          <div class="mt-auto pt-2 flex items-center gap-2 text-neutral-600 group-hover:text-primary-400 transition-colors" aria-hidden="true">
            <span class="font-heading text-xs tracking-widest uppercase">Jouer maintenant</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      <!-- ── Jeu statique : Séquence Viking ── -->
      <a href="/jeux/sequence" class="card-parchment rounded-lg overflow-hidden flex flex-col group hover:border-primary-400/40 transition-colors">
        <div class="h-48 bg-dark-900 flex items-center justify-center relative overflow-hidden">
          <div class="grid grid-cols-3 gap-2.5 select-none" aria-hidden="true">
            {['#dc2626','#2563eb','#16a34a','#ca8a04','#9333ea','#0891b2'].map((c, i) => (
              <div class={`w-10 h-10 rounded-xl ${i < 3 ? 'opacity-60' : 'opacity-20'}`} style={`background:${c}`} />
            ))}
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-dark-800/80 to-transparent pointer-events-none" />
          <div class="absolute top-3 right-3 px-2 py-1 rounded font-heading text-xs tracking-widest uppercase bg-primary-500/20 border border-primary-500/40 text-primary-300">
            Mémoire
          </div>
        </div>
        <div class="p-5 lg:p-6 flex flex-col gap-3 flex-1">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-heading text-lg text-neutral-200 tracking-wide group-hover:text-primary-300 transition-colors">Séquence Viking</h3>
            <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase shrink-0 mt-1">Jeu en ligne</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">Séquence</span>
            <span class="font-heading text-xs text-primary-400">3 → 9+ runes</span>
            <span class="text-neutral-600">·</span>
            <span class="font-heading text-xs text-primary-400">jusqu'à 100 XP / round</span>
          </div>
          <p class="font-body text-neutral-400 text-base line-clamp-3">Les runes s'allument dans un ordre secret. Mémorisez, puis reproduisez. Chaque round réussi ajoute une rune.</p>
          <div class="mt-auto pt-2 flex items-center gap-2 text-neutral-600 group-hover:text-primary-400 transition-colors" aria-hidden="true">
            <span class="font-heading text-xs tracking-widest uppercase">Jouer maintenant</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      {jeux.map((jeu: any) => (
        <a
          href={`/jeux/${jeu.id}`}
          class="card-parchment rounded-lg overflow-hidden flex flex-col group hover:border-primary-400/40 transition-colors"
        >
          <!-- Image -->
          {jeu.img && (
            <div class="h-48 relative overflow-hidden">
              <PbImage record={jeu} recordImage={jeu.img} width={600} height={192} />
              <div class="absolute inset-0 bg-linear-to-t from-dark-800/80 to-transparent pointer-events-none" />
            </div>
          )}

          <!-- Contenu -->
          <div class="p-5 lg:p-6 flex flex-col gap-3 flex-1">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-heading text-lg text-neutral-200 tracking-wide group-hover:text-primary-300 transition-colors">
                {jeu.nom}
              </h3>
              {jeu.type_de_jeux && (
                <StatusBadge class="px-2 py-1 rounded shrink-0">{jeu.type_de_jeux}</StatusBadge>
              )}
            </div>

            {jeu.difficulter != null && (
              <div class="flex items-center gap-2">
                <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">Difficulté</span>
                <div class="flex gap-1" aria-hidden="true">
                  {Array.from({ length: 10 }, (_, i) => (
                    <span class={`w-2 h-2 rounded-full ${i < jeu.difficulter ? 'bg-primary-400' : 'bg-dark-500'}`} />
                  ))}
                </div>
                <span class="font-heading text-xs text-primary-400">{jeu.difficulter}/10</span>
              </div>
            )}

            {jeu.descrition && (
              <p class="font-body text-neutral-400 text-base line-clamp-3">{jeu.descrition}</p>
            )}

            <div class="mt-auto pt-2 flex items-center gap-2 text-neutral-600 group-hover:text-primary-400 transition-colors" aria-hidden="true">
              <span class="font-heading text-xs tracking-widest uppercase">Voir le jeu</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

</Layout>
