---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

const jeux = [
  {
    href:   '/jeux/reflexes',
    badge:  'Réflexes',
    titre:  'Touche du Guerrier',
    type:   'Jeu en ligne',
    meta:   [{ label: 'XP', value: 'jusqu\'à 200 XP / manche' }],
    desc:   'Rouge : attendez. Vert : cliquez ! Testez votre temps de réaction et gagnez jusqu\'à 200 XP par manche.',
    cta:    'Jouer maintenant',
  },
  {
    href:   '/jeux/calculs',
    badge:  'Calcul mental',
    titre:  'Calculs du Jarl',
    type:   'Jeu en ligne',
    meta:   [{ label: 'Durée', value: '10 secondes' }, { label: 'XP', value: 'jusqu\'à 30 XP / calcul' }],
    desc:   'Maximum de calculs en 10 secondes. Plus vous en réussissez, plus ils deviennent difficiles — et plus vous rapportez d\'XP.',
    cta:    'Jouer maintenant',
  },
  {
    href:   '/jeux/vrai-faux',
    badge:  'Rapidité',
    titre:  'Vrai ou Faux',
    type:   'Jeu en ligne',
    meta:   [{ label: 'Durée', value: '30 secondes' }, { label: 'XP', value: 'jusqu\'à 25 XP / bonne réponse' }],
    desc:   'Une équation s\'affiche avec un résultat. Vrai ou faux ? Décidez le plus vite possible en 30 secondes.',
    cta:    'Jouer maintenant',
  },
  {
    href:   '/jeux/defi',
    badge:  'Physique',
    titre:  'Défis de la Horde',
    type:   'Jeu physique',
    meta:   [{ label: 'XP', value: 'selon le défi' }],
    desc:   'Un défi aléatoire tiré des archives de la horde. Relevez-le pour gagner de l\'XP. Échouez, et l\'honneur devra attendre.',
    cta:    'Relever le défi',
  },
  {
    href:   '/jeux/sequence',
    badge:  'Mémoire',
    titre:  'Séquence Viking',
    type:   'Jeu en ligne',
    meta:   [{ label: 'Séquence', value: '3 → 9+ runes' }, { label: 'XP', value: 'jusqu\'à 100 XP / round' }],
    desc:   'Les runes s\'allument dans un ordre secret. Mémorisez, puis reproduisez. Chaque round réussi ajoute une rune.',
    cta:    'Jouer maintenant',
  },
];
---
<Layout title="Les Jeux">

  <HeroSection title="Les Jeux" subtitle="Défis et tournois pour les guerriers" />

  <section class="max-w-360 mx-auto px-4 lg:px-20 py-10 lg:py-14">

    <div class="flex flex-col gap-4">

      {jeux.map(j => (
        <a href={j.href} class="card-parchment rounded-xl flex flex-col sm:flex-row items-stretch group hover:border-primary-400/40 transition-colors">

          <!-- Badge catégorie -->
          <div class="sm:w-40 shrink-0 flex items-center justify-center bg-dark-900/60 px-5 py-4 sm:py-0 border-b sm:border-b-0 sm:border-r border-dark-700">
            <span class="font-heading text-xs tracking-widest uppercase text-primary-500">{j.badge}</span>
          </div>

          <!-- Contenu -->
          <div class="p-5 lg:p-6 flex flex-col gap-2 flex-1 justify-center">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-heading text-lg text-neutral-200 tracking-wide group-hover:text-primary-300 transition-colors">
                {j.titre}
              </h3>
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase shrink-0 mt-0.5">{j.type}</span>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
              {j.meta.map((m, i) => (
                <>
                  {i > 0 && <span class="text-neutral-700">·</span>}
                  <span class="font-heading text-xs text-neutral-500 tracking-widest uppercase">{m.label}</span>
                  <span class="font-heading text-xs text-primary-400">{m.value}</span>
                </>
              ))}
            </div>

            <p class="font-body text-neutral-400 text-sm leading-relaxed max-w-xl">
              {j.desc}
            </p>
          </div>

          <!-- CTA -->
          <div class="flex items-center px-5 py-4 sm:py-0 border-t sm:border-t-0 sm:border-l border-dark-700 shrink-0">
            <div class="flex items-center gap-2 text-neutral-600 group-hover:text-primary-400 transition-colors">
              <span class="font-heading text-xs tracking-widest uppercase whitespace-nowrap">{j.cta}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>

        </a>
      ))}

    </div>
  </section>

</Layout>
