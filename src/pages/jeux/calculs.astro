---
import Layout from '../../layouts/Layout.astro';
import { PB_BASE_URL } from '../../../backend/backend.js';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');
---
<Layout title="Calculs du Jarl — AEgirhall">

  <!-- ── HEADER ───────────────────────────────────────────── -->
  <section class="bg-dark-900 border-b border-dark-700 py-8 lg:py-10">
    <div class="max-w-360 mx-auto px-4 lg:px-20">
      <a href="/jeux" class="font-heading text-xs text-neutral-600 hover:text-neutral-400 tracking-widest uppercase transition-colors">
        ← Tous les jeux
      </a>
      <div class="mt-4">
        <p class="font-heading text-xs text-primary-500 tracking-widest uppercase mb-2">Jeu de calcul mental</p>
        <h1 class="font-display text-3xl lg:text-5xl text-neutral-100 tracking-widest">Calculs du Jarl</h1>
        <p class="font-body text-neutral-400 text-base mt-2 max-w-xl">
          30 secondes. Le plus de calculs possible. Plus vous en réussissez, plus ils deviennent difficiles — et plus vous gagnez d'XP.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CONTENU ───────────────────────────────────────────── -->
  <section class="max-w-360 mx-auto px-4 lg:px-20 py-8 lg:py-12">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start">

      <!-- ── Colonne gauche : infos ── -->
      <div class="w-full lg:w-72 shrink-0 flex flex-col gap-5">

        <!-- Progression des niveaux -->
        <div class="card-parchment rounded-xl p-5">
          <p class="label-viking mb-4">Niveaux & XP</p>
          <div class="flex flex-col gap-1.5">
            {([
              { level: 1, range: '1 – 3 bons',  ops: '+ −  (1-10)',       xp: 5  },
              { level: 2, range: '4 – 6 bons',  ops: '+ − × (1-20)',      xp: 10 },
              { level: 3, range: '7 – 10 bons', ops: '+ − × ÷ (1-50)',    xp: 15 },
              { level: 4, range: '11-14 bons',  ops: '× ÷ grands nombres', xp: 20 },
              { level: 5, range: '15+ bons',    ops: 'Calculs composés',   xp: 30 },
            ] as const).map(row => (
              <div class="flex items-center gap-3 p-2.5 rounded-lg bg-dark-700 border border-dark-600">
                <div class="w-7 h-7 rounded-full bg-primary-400/20 border border-primary-400/40 flex items-center justify-center shrink-0">
                  <span class="font-heading text-xs text-primary-300">{row.level}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-heading text-xs text-neutral-300 tracking-wide">{row.range}</p>
                  <p class="font-body text-xs text-neutral-600">{row.ops}</p>
                </div>
                <span class="font-display text-xs text-primary-300 shrink-0">+{row.xp} XP</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Règles -->
        <div class="card-parchment rounded-xl p-5">
          <p class="label-viking mb-3">Règles</p>
          <ul class="flex flex-col gap-2.5">
            {[
              { c: 'text-primary-300', t: '10 secondes, le plus de calculs possible' },
              { c: 'text-primary-300', t: 'Mauvaise réponse : l\'input se vide, le calcul reste' },
              { c: 'text-primary-300', t: 'Les calculs s\'enchaînent automatiquement si bonne réponse' },
              { c: 'text-primary-300', t: 'L\'XP s\'accumule selon la difficulté atteinte' },
            ].map(r => (
              <li class="flex items-start gap-2.5">
                <span class={`${r.c} text-xs mt-0.5 shrink-0`}>▸</span>
                <span class="font-body text-xs text-neutral-400">{r.t}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Total session -->
        <div id="session-total" class="hidden card-parchment rounded-xl p-5">
          <p class="label-viking mb-2">Session en cours</p>
          <div class="flex items-center justify-between">
            <span class="font-body text-sm text-neutral-500">XP gagné</span>
            <span id="total-xp-val" class="font-display text-xl text-primary-300">0 XP</span>
          </div>
        </div>
      </div>

      <!-- ── Colonne droite : jeu ── -->
      <div class="flex-1 card-parchment rounded-2xl overflow-hidden flex flex-col">

        <!-- Bouton de démarrage (état initial) -->
        <div id="start-wrap" class="flex flex-col items-center justify-center gap-6 p-12 lg:p-16">
          <div class="text-6xl select-none" aria-hidden="true">🧮</div>
          <p class="font-body text-neutral-400 text-center max-w-xs">
            Répondez à un maximum de calculs en <strong class="text-neutral-200">30 secondes</strong>. Ils deviennent de plus en plus difficiles !
          </p>
          <button id="start-btn" class="btn-primary px-10 py-3 text-sm">
            ⚔ Lancer le défi
          </button>
        </div>

        <!-- Zone de jeu (cachée au départ) -->
        <div id="game-area" class="hidden flex-col">

          <!-- Timer bar -->
          <div class="h-2 bg-dark-700 w-full">
            <div id="timer-bar" class="h-full transition-none" style="width:100%;background-color:#2D6A4F;"></div>
          </div>

          <!-- Header : score + niveau + temps -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-dark-600 bg-dark-700/40">
            <div class="flex items-center gap-4">
              <div class="flex flex-col">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Bons</span>
                <span id="score-display" class="font-display text-2xl text-primary-300 leading-none">0</span>
              </div>
              <div class="w-px h-8 bg-dark-600" />
              <div class="flex flex-col">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">XP accumulé</span>
                <span id="live-xp" class="font-display text-2xl text-primary-300 leading-none">0</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span id="level-badge" class="px-3 py-1 rounded-full font-heading text-xs tracking-widest uppercase bg-primary-400/10 border border-primary-400/30 text-primary-400">Niv. 1</span>
              <div class="flex flex-col items-end">
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Temps</span>
                <span id="timer-text" class="font-display text-2xl text-neutral-200 leading-none">10s</span>
              </div>
            </div>
          </div>

          <!-- Question -->
          <div class="flex-1 flex flex-col items-center justify-center gap-6 lg:gap-8 px-6 py-10 lg:py-14">
            <p id="question-display"
               class="font-display text-4xl lg:text-6xl text-neutral-100 tracking-wide text-center select-none"
               aria-live="polite">
            </p>

            <div class="flex gap-3 w-full max-w-xs">
              <input
                id="answer-input"
                type="number"
                inputmode="numeric"
                placeholder="?"
                autocomplete="off"
                aria-label="Votre réponse"
                class="input-viking flex-1 text-center text-2xl lg:text-3xl font-display tracking-wide py-4"
              />
              <button id="submit-btn" class="btn-primary px-5 py-4 text-xl" aria-label="Valider">
                →
              </button>
            </div>
          </div>
        </div>

        <!-- Résultat (caché au départ) -->
        <div id="game-result" class="hidden flex-col items-center gap-5 p-10 lg:p-14 text-center">
          <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Temps écoulé !</p>
          <div class="flex items-baseline gap-3">
            <span id="res-score" class="font-display text-7xl text-primary-300">0</span>
            <span class="font-heading text-lg text-neutral-500 tracking-wide">calculs réussis</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex flex-col items-center px-4 py-2 rounded-lg bg-dark-700 border border-dark-600">
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-1">Niveau atteint</span>
              <span id="res-level" class="font-display text-lg text-primary-400">1</span>
            </div>
            <div class="flex flex-col items-center px-4 py-2 rounded-lg bg-primary-400/10 border border-primary-400/30">
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-1">XP gagné</span>
              <span id="res-xp" class="font-display text-lg text-primary-300">+0 XP</span>
            </div>
          </div>
          <button id="replay-btn" class="btn-primary px-8 py-3 text-sm mt-2">
            ⟳ Rejouer
          </button>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  @keyframes shake-input {
    0%, 100% { transform: translateX(0); }
    20%       { transform: translateX(-8px); }
    40%       { transform: translateX(8px); }
    60%       { transform: translateX(-5px); }
    80%       { transform: translateX(5px); }
  }
  #answer-input.shake {
    animation: shake-input 0.35s ease;
    border-color: var(--color-accent-blood) !important;
  }

  /* Retirer les flèches du champ number */
  #answer-input::-webkit-outer-spin-button,
  #answer-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  #answer-input { -moz-appearance: textfield; }
</style>

<script define:vars={{ _token: token, _userId: userId, _pbUrl: PB_BASE_URL }} is:inline>
(function() {
  var TIME_LIMIT = 30;

  var score     = 0;
  var totalXp   = 0;
  var sessionXp = 0;
  var phase     = 'idle';
  var currentAnswer = 0;
  var currentXp     = 0;
  var timerRAF  = null;
  var startTime = 0;

  var startWrap    = document.getElementById('start-wrap');
  var startBtn     = document.getElementById('start-btn');
  var gameArea     = document.getElementById('game-area');
  var resultEl     = document.getElementById('game-result');
  var questionEl   = document.getElementById('question-display');
  var answerInput  = document.getElementById('answer-input');
  var submitBtn    = document.getElementById('submit-btn');
  var timerBar     = document.getElementById('timer-bar');
  var timerText    = document.getElementById('timer-text');
  var scoreEl      = document.getElementById('score-display');
  var liveXpEl     = document.getElementById('live-xp');
  var levelBadge   = document.getElementById('level-badge');
  var resScore     = document.getElementById('res-score');
  var resXp        = document.getElementById('res-xp');
  var resLevel     = document.getElementById('res-level');
  var replayBtn    = document.getElementById('replay-btn');
  var totalWrap    = document.getElementById('session-total');
  var totalVal     = document.getElementById('total-xp-val');

  /* ── Utilitaires ── */
  function rand(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function getLevel(n) {
    if (n < 3)  return 1;
    if (n < 6)  return 2;
    if (n < 10) return 3;
    if (n < 14) return 4;
    return 5;
  }

  function xpForLevel(lvl) {
    return [0, 5, 10, 15, 20, 30][Math.min(lvl, 5)];
  }

  /* ── Génération de questions ── */
  function generateQuestion(level) {
    var a, b, c, question, answer;

    if (level <= 1) {
      a = rand(1, 10); b = rand(1, 10);
      if (rand(0, 1)) { question = a + ' + ' + b; answer = a + b; }
      else { if (a < b) { c = a; a = b; b = c; } question = a + ' − ' + b; answer = a - b; }

    } else if (level === 2) {
      var op2 = rand(0, 2);
      if (op2 === 0) { a = rand(5, 20); b = rand(5, 20); question = a + ' + ' + b; answer = a + b; }
      else if (op2 === 1) { a = rand(10, 30); b = rand(1, a - 1); question = a + ' − ' + b; answer = a - b; }
      else { a = rand(2, 5); b = rand(2, 9); question = a + ' × ' + b; answer = a * b; }

    } else if (level === 3) {
      var op3 = rand(0, 3);
      if (op3 === 0) { a = rand(10, 50); b = rand(10, 50); question = a + ' + ' + b; answer = a + b; }
      else if (op3 === 1) { a = rand(20, 80); b = rand(5, a - 1); question = a + ' − ' + b; answer = a - b; }
      else if (op3 === 2) { a = rand(3, 10); b = rand(3, 10); question = a + ' × ' + b; answer = a * b; }
      else { b = rand(2, 9); answer = rand(2, 10); a = b * answer; question = a + ' ÷ ' + b; }

    } else if (level === 4) {
      var op4 = rand(0, 3);
      if (op4 === 0) { a = rand(20, 100); b = rand(20, 100); question = a + ' + ' + b; answer = a + b; }
      else if (op4 === 1) { a = rand(40, 150); b = rand(10, a - 1); question = a + ' − ' + b; answer = a - b; }
      else if (op4 === 2) { a = rand(4, 12); b = rand(4, 12); question = a + ' × ' + b; answer = a * b; }
      else { b = rand(3, 12); answer = rand(3, 12); a = b * answer; question = a + ' ÷ ' + b; }

    } else {
      var op5 = rand(0, 2);
      if (op5 === 0) { a = rand(3, 12); b = rand(3, 12); c = rand(1, 30); question = a + ' × ' + b + ' + ' + c; answer = a * b + c; }
      else if (op5 === 1) { a = rand(3, 12); b = rand(3, 12); c = rand(1, 20); answer = a * b - c; if (answer < 0) answer = -answer; question = a + ' × ' + b + ' − ' + c; }
      else { a = rand(5, 20); b = rand(5, 20); c = rand(2, 9); question = '(' + a + ' + ' + b + ') × ' + c; answer = (a + b) * c; }
    }

    return { question: question, answer: answer, xp: xpForLevel(level) };
  }

  /* ── Timer (requestAnimationFrame) ── */
  function tickTimer() {
    var elapsed = (Date.now() - startTime) / 1000;
    var left    = Math.max(0, TIME_LIMIT - elapsed);
    var pct     = (left / TIME_LIMIT) * 100;

    timerBar.style.width = pct + '%';
    timerBar.style.backgroundColor = pct > 60 ? '#2D6A4F' : pct > 30 ? '#94701C' : '#8C1C13';
    timerText.textContent = Math.ceil(left) + 's';

    if (left <= 0) { endGame(); return; }
    timerRAF = requestAnimationFrame(tickTimer);
  }

  /* ── Flux de jeu ── */
  function startGame() {
    score = 0; totalXp = 0; phase = 'playing';
    startWrap.classList.add('hidden');
    gameArea.classList.remove('hidden');
    gameArea.classList.add('flex');
    resultEl.classList.add('hidden');
    resultEl.classList.remove('flex');
    nextQuestion();
    startTime = Date.now();
    timerRAF = requestAnimationFrame(tickTimer);
  }

  function nextQuestion() {
    var lvl = getLevel(score);
    var q   = generateQuestion(lvl);
    currentAnswer = q.answer;
    currentXp     = q.xp;
    questionEl.textContent = q.question + ' = ?';
    levelBadge.textContent = 'Niv. ' + lvl;
    scoreEl.textContent    = score;
    liveXpEl.textContent   = totalXp + ' XP';
    answerInput.value = '';
    answerInput.classList.remove('shake');
    answerInput.focus();
  }

  function checkAnswer() {
    if (phase !== 'playing') return;
    var val = parseInt(answerInput.value.trim(), 10);
    if (isNaN(val)) { answerInput.focus(); return; }

    if (val === currentAnswer) {
      score++;
      totalXp += currentXp;
      nextQuestion();
    } else {
      answerInput.classList.remove('shake');
      void answerInput.offsetWidth;
      answerInput.classList.add('shake');
      answerInput.value = '';
      answerInput.focus();
    }
  }

  function endGame() {
    if (phase !== 'playing') return;
    phase = 'done';
    cancelAnimationFrame(timerRAF);

    gameArea.classList.add('hidden');
    gameArea.classList.remove('flex');
    resultEl.classList.remove('hidden');
    resultEl.classList.add('flex');

    resScore.textContent = score;
    resXp.textContent    = '+' + totalXp + ' XP';
    resLevel.textContent = 'Niveau ' + getLevel(score);
    startBtn && (startBtn.textContent = '⟳ Rejouer');

    sessionXp += totalXp;
    if (totalWrap) {
      totalWrap.classList.remove('hidden');
      totalVal.textContent = sessionXp + ' XP';
    }

    if (totalXp > 0) saveXp(totalXp);
  }

  function saveXp(xp) {
    fetch(_pbUrl + '/api/collections/users/records/' + _userId, {
      headers: { 'Authorization': 'Bearer ' + _token },
    })
    .then(function(r) { return r.json(); })
    .then(function(user) {
      return fetch(_pbUrl + '/api/collections/users/records/' + _userId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + _token },
        body: JSON.stringify({ xp: Number(user.xp || 0) + xp }),
      });
    }).catch(function() {});
  }

  /* ── Événements ── */
  startBtn  && startBtn.addEventListener('click',  startGame);
  replayBtn && replayBtn.addEventListener('click', startGame);
  submitBtn && submitBtn.addEventListener('click',  checkAnswer);
  answerInput && answerInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') checkAnswer();
  });
})();
</script>