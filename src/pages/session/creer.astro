---
import Layout from '../../layouts/Layout.astro';
import PbImage from '../../components/PbImage.astro';
import { Image } from 'astro:assets';
import { getCollection, getRecord, createSession } from '../../../backend/backend.js';
import personnesIcon from '../../assets/icon/personnes.svg';
import voitureIcon   from '../../assets/icon/voiture.svg';
import bierreIcon    from '../../assets/icon/bierre.svg';
import bouclierIcon  from '../../assets/icon/bouclier.svg';
import tempsIcon     from '../../assets/icon/Temps.svg';
import jeuIcon       from '../../assets/icon/jeux.svg';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const nom             = form.get('nom')?.toString().trim() ?? '';
  const description     = form.get('description')?.toString().trim() ?? '';
  const dateDepart      = form.get('date_heur_depart')?.toString() ?? '';
  const dateArrivee     = form.get('date_heur_arriver')?.toString() ?? '';
  const selectedBars    = form.getAll('bars').map(v => v.toString());
  const selectedMembers = form.getAll('members').map(v => v.toString());
  const selectedJeux    = form.getAll('jeux').map(v => v.toString());
  const samId           = form.get('sam')?.toString() ?? '';

  const toIso = (val: string) => {
    if (!val) return null;
    const d = new Date(val);
    return isNaN(d.getTime()) ? null : d.toISOString();
  };

  const allMembers = [...new Set([userId, ...selectedMembers])];

  const session = await createSession({
    nom,
    description,
    date_heur_depart:  toIso(dateDepart),
    date_heur_arriver: toIso(dateArrivee),
    id_hote:      userId,
    id_menbre:    allMembers,
    id_bar:       selectedBars,
    id_jeux:      selectedJeux,
    id_sam:       samId || null,
    etat_session: 'pas_commencer',
  }, token);

  if (session?.error) {
    error = Object.values(session.error?.data ?? {}).map((v: any) => v?.message).filter(Boolean).join(' ') || session.error?.message || 'Erreur de création.';
  } else {
    return Astro.redirect(`/session/${session.id}?joined=1`);
  }
}

const [bars, jeux, me] = await Promise.all([
  getCollection('bar', { sort: 'nom', token }),
  getCollection('jeux', { sort: 'nom', token }),
  getRecord('users', userId, { expand: 'amies', token }),
]);

const otherUsers = me?.expand?.amies ?? [];
const mePseudo   = me?.pseudo ?? me?.nom ?? 'Vous';
---
<Layout title="Forger une Session">
  <section class="min-h-[calc(100vh-92px)] py-12 px-4">
    <div class="max-w-2xl mx-auto">

      <!-- Titre -->
      <div class="text-center mb-10">
        <h1 class="font-display text-3xl lg:text-4xl text-neutral-100 tracking-widest mb-3">Forger une Session</h1>
        <p class="font-body text-neutral-500">Organisez votre barathon en 4 étapes</p>
      </div>

      <!-- Indicateur d'étapes -->
      <div class="flex items-center justify-center mb-10" id="step-indicator">
        {[
          { n: 1, label: 'Groupe',  icon: personnesIcon },
          { n: 2, label: 'Gardien', icon: voitureIcon   },
          { n: 3, label: 'Soirée',  icon: bierreIcon    },
          { n: 4, label: 'Résumé',  icon: bouclierIcon  },
        ].map(({ n, label, icon }, i) => (
          <div class="flex items-center">
            <div class="flex flex-col items-center gap-1.5">
              <div class={`step-dot w-10 h-10 rounded-full border-2 flex items-center justify-center transition-all ${n === 1 ? 'border-primary-400 bg-primary-400/20' : 'border-dark-600 bg-dark-700'}`} data-step={n}>
                <span class="step-num pointer-events-none">
                  <Image src={icon} alt="" width={18} height={18} class={n === 1 ? 'brightness-0 invert opacity-80' : 'brightness-0 invert opacity-25'} aria-hidden="true" />
                </span>
                <span class="step-check hidden font-heading text-sm text-primary-400 font-bold select-none">✓</span>
              </div>
              <span class={`step-label font-heading text-xs tracking-widest uppercase ${n === 1 ? 'text-primary-400' : 'text-neutral-600'}`} id={`step-label-${n}`}>{label}</span>
            </div>
            {i < 3 && <div class="step-connector w-8 lg:w-14 h-px bg-dark-600 mb-5 mx-1" />}
          </div>
        ))}
      </div>

      <!-- Erreur -->
      {error && (
        <div class="mb-6 p-4 rounded bg-accent-blood/20 border border-accent-blood/50 font-body text-sm text-neutral-300">
          {error}
        </div>
      )}

      <!-- Formulaire unique -->
      <form method="POST" id="wizard-form">

        <!-- ── ÉTAPE 1 : Groupe ── -->
        <div id="step-1" class="wizard-step flex flex-col gap-5">

          <!-- Infos session -->
          <div class="card-parchment rounded-xl p-6 lg:p-8 flex flex-col gap-5">
            <div class="flex items-center gap-2.5 mb-1">
              <div class="w-8 h-8 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={bierreIcon} alt="" width={16} height={16} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">La Session</h2>
            </div>
            <div>
              <label class="label-viking" for="nom">Nom de la session *</label>
              <input id="nom" name="nom" type="text" required placeholder="La Nuit des Jarls" class="input-viking" />
            </div>
            <div>
              <label class="label-viking" for="description">Description</label>
              <textarea id="description" name="description" rows="3" class="input-viking resize-none" placeholder="Décrivez votre barathon..."></textarea>
            </div>
          </div>

          <!-- Membres -->
          <div class="card-parchment rounded-xl p-6 lg:p-8">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={personnesIcon} alt="" width={16} height={16} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">Inviter vos compagnons</h2>
            </div>
            <p class="font-body text-neutral-500 text-sm mb-5">Vous êtes automatiquement l'hôte. Invitez vos compagnons de horde.</p>
            <div class="flex flex-col gap-2 max-h-96 overflow-y-auto pr-1">
              {otherUsers.map(u => (
                <label class="selection-card flex items-center gap-4 card-parchment rounded-lg p-4 cursor-pointer hover:border-primary-400/40 transition-colors">
                  <input type="checkbox" name="members" value={u.id} class="selection-cb sr-only" />
                  <div class="w-10 h-10 rounded-full bg-dark-600 border border-dark-500 overflow-hidden flex items-center justify-center shrink-0">
                    {u.avatar
                      ? <PbImage record={u} recordImage={u.avatar} width={40} height={40} />
                      : <span class="font-heading text-sm text-primary-400">{(u.pseudo ?? u.nom)?.charAt(0)?.toUpperCase() ?? 'V'}</span>
                    }
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-heading text-sm text-neutral-200 tracking-wide">{u.pseudo ?? u.nom}</p>
                    {u.titre && <p class="font-body text-xs text-neutral-500">{u.titre}</p>}
                  </div>
                  <div class="check-icon w-6 h-6 rounded border-2 border-dark-500 flex items-center justify-center shrink-0 transition-all">
                    <span class="check-mark hidden text-primary-400 text-xs font-bold">✓</span>
                  </div>
                </label>
              ))}
              {otherUsers.length === 0 && (
                <p class="font-body text-neutral-500 text-center py-8">
                  Vous n'avez pas encore d'amis. Ajoutez-en depuis votre <a href="/profil#amis" class="text-primary-400 hover:underline">profil</a>.
                </p>
              )}
            </div>
          </div>
        </div>

        <!-- ── ÉTAPE 2 : Gardien ── -->
        <div id="step-2" class="wizard-step hidden">
          <div class="card-parchment rounded-xl p-6 lg:p-8 flex flex-col gap-5">

            <!-- Header -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={voitureIcon} alt="" width={20} height={20} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <div>
                <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">Le Gardien</h2>
                <p class="font-body text-sm text-neutral-500 mt-1 leading-relaxed">
                  Le Gardien (SAM) veille sur le groupe et ne consomme pas d'alcool ce soir. Il peut aussi être désigné depuis la page de session.
                </p>
              </div>
            </div>

            <!-- Info note -->
            <div class="flex items-center gap-3 p-3 rounded-lg bg-dark-700/50 border border-dark-500/30">
              <span class="text-primary-400 shrink-0">⚔</span>
              <p class="font-body text-xs text-neutral-500 leading-relaxed">
                La désignation d'un Gardien est obligatoire pour démarrer une session. Vous pouvez la modifier plus tard.
              </p>
            </div>

            <!-- Liste dynamique — peuplée par wizard.js -->
            <div id="gardien-list" class="flex flex-col gap-2">
              <!-- JS populates this from members selected in step 1 -->
            </div>
            <p id="gardien-empty" class="hidden font-body text-neutral-500 text-center py-8">
              Aucun membre sélectionné. Vous serez l'unique option — assignez le Gardien après la création si besoin.
            </p>
          </div>
        </div>

        <!-- ── ÉTAPE 3 : Soirée ── -->
        <div id="step-3" class="wizard-step hidden">
        <div class="flex flex-col gap-5">

          <!-- Dates -->
          <div class="card-parchment rounded-xl p-6 lg:p-8 flex flex-col gap-5">
            <div class="flex items-center gap-2.5 mb-1">
              <div class="w-8 h-8 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={tempsIcon} alt="" width={16} height={16} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">Horaires</h2>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div>
                <label class="label-viking" for="date_heur_depart">Heure de départ</label>
                <input id="date_heur_depart" name="date_heur_depart" type="datetime-local" class="input-viking" />
              </div>
              <div>
                <label class="label-viking" for="date_heur_arriver">Heure d'arrivée prévue</label>
                <input id="date_heur_arriver" name="date_heur_arriver" type="datetime-local" class="input-viking" />
              </div>
            </div>
          </div>

          <!-- Bars -->
          <div class="card-parchment rounded-xl p-6 lg:p-8">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={bierreIcon} alt="" width={16} height={16} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">Tavernes</h2>
            </div>
            <p class="font-body text-neutral-500 text-sm mb-5">Sélectionnez les bars pour votre route des Jarls.</p>
            <div class="flex flex-col gap-2 max-h-96 overflow-y-auto pr-1">
              {bars.map(bar => (
                <label class="selection-card flex items-center gap-4 card-parchment rounded-lg p-4 cursor-pointer hover:border-primary-400/40 transition-colors">
                  <input type="checkbox" name="bars" value={bar.id} class="selection-cb sr-only" />
                  <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 bg-dark-700">
                    {bar.img && <PbImage record={bar} recordImage={bar.img} width={48} height={48} />}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-heading text-sm text-neutral-200 tracking-wide">{bar.nom}</p>
                    {bar.adresse && <p class="font-body text-xs text-neutral-500 truncate">{bar.adresse}</p>}
                  </div>
                  <div class="check-icon w-6 h-6 rounded border-2 border-dark-500 flex items-center justify-center shrink-0 transition-all">
                    <span class="check-mark hidden text-primary-400 text-xs font-bold">✓</span>
                  </div>
                </label>
              ))}
              {bars.length === 0 && <p class="font-body text-neutral-500 text-center py-8">Aucune taverne disponible.</p>}
            </div>
          </div>

          <!-- Jeux -->
          <div class="card-parchment rounded-xl p-6 lg:p-8">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={jeuIcon} alt="" width={16} height={16} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">Jeux</h2>
            </div>
            <p class="font-body text-neutral-500 text-sm mb-5">Optionnel — Animez votre barathon avec des défis.</p>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 max-h-96 overflow-y-auto pr-1">
              {jeux.map(jeu => (
                <label class="selection-card card-parchment rounded-lg overflow-hidden cursor-pointer hover:border-primary-400/40 transition-colors">
                  <input type="checkbox" name="jeux" value={jeu.id} class="selection-cb sr-only" />
                  {jeu.img && (
                    <div class="h-24 overflow-hidden">
                      <PbImage record={jeu} recordImage={jeu.img} width={300} height={96} />
                    </div>
                  )}
                  <div class="p-3 flex items-center gap-3">
                    <div class="flex-1 min-w-0">
                      <p class="font-heading text-sm text-neutral-200 tracking-wide">{jeu.nom}</p>
                      {jeu.difficulter != null && <p class="font-body text-xs text-neutral-500">Difficulté : {jeu.difficulter}/10</p>}
                    </div>
                    <div class="check-icon w-6 h-6 rounded border-2 border-dark-500 flex items-center justify-center shrink-0 transition-all">
                      <span class="check-mark hidden text-primary-400 text-xs font-bold">✓</span>
                    </div>
                  </div>
                </label>
              ))}
              {jeux.length === 0 && <p class="font-body text-neutral-500 text-center py-8 col-span-2">Aucun jeu disponible.</p>}

              <!-- Séparateur jeux en ligne -->
              <div class="col-span-2 flex items-center gap-3 pt-1">
                <div class="flex-1 h-px bg-dark-600" />
                <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase shrink-0">Jeux en ligne — toujours disponibles</span>
                <div class="flex-1 h-px bg-dark-600" />
              </div>

              {([
                { nom: 'Touche du Guerrier', desc: 'Réflexes — Rouge → Vert',    href: '/jeux/reflexes', xp: '50–200 XP', icon: '◉' },
                { nom: 'Calculs du Jarl',   desc: 'Calcul mental — 30 sec',      href: '/jeux/calculs',  xp: '5–30 XP',   icon: '🧮' },
                { nom: 'Vrai ou Faux',      desc: 'Équations — 30 sec',          href: '/jeux/vrai-faux',xp: '5–25 XP',   icon: '✓✗' },
                { nom: 'Séquence Viking',   desc: 'Mémoire — reproduisez l\'ordre', href: '/jeux/sequence',xp: '20–100 XP', icon: '◆' },
              ] as const).map(g => (
                <div class="card-parchment rounded-lg overflow-hidden col-span-1">
                  <div class="h-12 bg-dark-900 flex items-center justify-center select-none" aria-hidden="true">
                    <span class="text-2xl opacity-30">{g.icon}</span>
                  </div>
                  <div class="p-3 flex items-center gap-3">
                    <div class="flex-1 min-w-0">
                      <p class="font-heading text-sm text-neutral-200 tracking-wide">{g.nom}</p>
                      <p class="font-body text-xs text-neutral-500">{g.desc}</p>
                    </div>
                    <a href={g.href} target="_blank" rel="noopener"
                       class="font-heading text-xs text-primary-400 hover:text-primary-300 tracking-widest uppercase shrink-0 transition-colors"
                       aria-label={`Jouer à ${g.nom}`}>
                      Jouer →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        </div>

        <!-- ── ÉTAPE 4 : Résumé ── -->
        <div id="step-4" class="wizard-step hidden">
          <div class="card-parchment rounded-xl p-6 lg:p-8 flex flex-col gap-5">

            <!-- Header -->
            <div class="flex items-center gap-2.5 mb-1">
              <div class="w-8 h-8 rounded-lg bg-primary-600/20 border border-primary-500/30 flex items-center justify-center shrink-0">
                <Image src={bouclierIcon} alt="" width={16} height={16} class="brightness-0 invert opacity-70" aria-hidden="true" />
              </div>
              <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase">Résumé</h2>
            </div>

            <!-- Nom session -->
            <div>
              <p class="label-viking mb-1">Session</p>
              <p id="res-nom" class="font-heading text-xl text-neutral-100 tracking-wide">—</p>
            </div>

            <!-- Description -->
            <div>
              <p class="label-viking mb-1">Description</p>
              <p id="res-desc" class="font-body text-sm text-neutral-400 leading-relaxed">—</p>
            </div>

            <div class="h-px bg-dark-600" />

            <!-- Membres + Gardien -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
              <div>
                <p class="label-viking mb-2 flex items-center gap-1.5">
                  <Image src={personnesIcon} alt="" width={12} height={12} class="brightness-0 invert opacity-50" aria-hidden="true" />
                  Membres
                </p>
                <p id="res-membres" class="font-body text-sm text-neutral-400 leading-relaxed">—</p>
              </div>
              <div>
                <p class="label-viking mb-2 flex items-center gap-1.5">
                  <Image src={voitureIcon} alt="" width={12} height={12} class="brightness-0 invert opacity-50" aria-hidden="true" />
                  Gardien (SAM)
                </p>
                <p id="res-sam" class="font-heading text-sm text-primary-400 tracking-wide">—</p>
              </div>
            </div>

            <div class="h-px bg-dark-600" />

            <!-- Dates -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
              <div>
                <p class="label-viking mb-1">Départ</p>
                <p id="res-depart" class="font-body text-sm text-neutral-400">—</p>
              </div>
              <div>
                <p class="label-viking mb-1">Arrivée prévue</p>
                <p id="res-arrivee" class="font-body text-sm text-neutral-400">—</p>
              </div>
            </div>

            <div class="h-px bg-dark-600" />

            <!-- Tavernes + Jeux -->
            <div>
              <p class="label-viking mb-2 flex items-center gap-1.5">
                <Image src={bierreIcon} alt="" width={12} height={12} class="brightness-0 invert opacity-50" aria-hidden="true" />
                Tavernes
              </p>
              <p id="res-bars" class="font-body text-sm text-neutral-400 leading-relaxed">Aucune taverne sélectionnée</p>
            </div>
            <div>
              <p class="label-viking mb-2 flex items-center gap-1.5">
                <Image src={jeuIcon} alt="" width={12} height={12} class="brightness-0 invert opacity-50" aria-hidden="true" />
                Jeux
              </p>
              <p id="res-jeux" class="font-body text-sm text-neutral-400 leading-relaxed">Aucun jeu sélectionné</p>
            </div>

            <div class="flex items-center gap-3 p-3 rounded-lg bg-primary-400/5 border border-primary-400/20 mt-1">
              <span class="text-primary-400 shrink-0">✦</span>
              <p class="font-body text-xs text-neutral-500 leading-relaxed">
                La session sera créée en état « non démarrée ». Vous pourrez l'ajuster depuis la page de session avant de la lancer.
              </p>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex items-center mt-6 gap-3">
          <button type="button" id="btn-prev" class="btn-outline px-6 py-3" style="display:none">← Précédent</button>
          <div class="flex-1" />
          <button type="button" id="btn-next" class="btn-primary px-6 py-3">Suivant →</button>
          <button type="submit" id="btn-submit" class="btn-primary px-8 py-3" style="display:none">⚔ Forger la session</button>
        </div>

      </form>
    </div>
  </section>
</Layout>

<!-- Données SSR → wizard.js -->
<div id="wizard-data"
  data-users={JSON.stringify(otherUsers.map(u => ({ id: u.id, name: u.pseudo ?? u.nom ?? 'Guerrier' })))}
  data-bars={JSON.stringify(bars.map(b => ({ id: b.id, nom: b.nom })))}
  data-jeux={JSON.stringify(jeux.map(j => ({ id: j.id, nom: j.nom })))}
  data-me-id={userId}
  data-me-name={mePseudo}
  hidden
/>

<script>
  import '../../js/wizard.js';
</script>