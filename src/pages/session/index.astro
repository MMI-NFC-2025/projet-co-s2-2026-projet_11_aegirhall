---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';
import { Image } from 'astro:assets';
import barque from '../../assets/img/barque.avif';
import { getCollection, getRecord, getMe } from '../../js/backend.js';
import StatusBadge from '../../components/StatusBadge.astro';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

const [mySessions, myUser] = await Promise.all([
  getCollection('session_barathon', {
    filter: `id_menbre ~ "${userId}" || id_hote = "${userId}"`,
    sort: '-created',
    expand: 'id_hote',
    token,
  }),
  getMe(userId, token),
]);

const pendingIds = myUser?.demande_session ?? [];
const pendingSessions = (
  await Promise.all(pendingIds.slice(0, 10).map(sid => getRecord('session_barathon', sid, { token })))
).filter(Boolean);

const enCours  = mySessions.filter(s => s.etat_session === 'en_court');
const planifie = mySessions.filter(s => s.etat_session === 'pas_commencer');
const termine  = mySessions.filter(s => s.etat_session === 'fini');
---
<Layout title="Sessions">

  <HeroSection title="Sessions" subtitle="Vos barathons vikings" />

  <div class="max-w-360 mx-auto px-4 lg:px-20 py-10 lg:py-14 flex flex-col gap-10">

    <!-- Invitations en attente -->
    {pendingSessions.length > 0 && (
      <section>
        <h2 class="font-heading text-xl text-neutral-200 tracking-wide mb-5">Invitations en attente</h2>
        <div class="flex flex-col gap-3">
          {pendingSessions.map(s => (
            <div class="card-parchment rounded-lg p-5 flex flex-col lg:flex-row lg:items-center gap-4 border-primary-400/30">
              <div class="flex-1">
                <p class="font-heading text-base text-neutral-200 tracking-wide mb-1">{s.nom || 'Session sans nom'}</p>
                {s.date_heur_depart && (
                  <p class="font-body text-sm text-neutral-500">
                    {new Date(s.date_heur_depart).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' })}
                  </p>
                )}
              </div>
              <div class="flex gap-3 shrink-0">
                <form method="POST" action={`/session/${s.id}`}>
                  <input type="hidden" name="action" value="accept_invitation" />
                  <button type="submit" class="btn-primary text-xs px-5 py-2">Accepter</button>
                </form>
                <form method="POST" action={`/session/${s.id}`}>
                  <input type="hidden" name="action" value="reject_invitation" />
                  <button type="submit" class="btn-outline text-xs px-5 py-2">Refuser</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Header section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <h2 class="font-heading text-xl text-neutral-200 tracking-wide">Mes Sessions</h2>
      <a href="/session/creer" class="btn-primary px-6 py-3 self-start sm:self-auto">+ Créer une session</a>
    </div>

    <!-- En cours -->
    {enCours.length > 0 && (
      <section>
        <h3 class="font-heading text-xs text-accent-rune tracking-widest uppercase mb-4">En cours</h3>
        <div class="flex flex-col gap-3">
          {enCours.map(s => (
            <a href={`/session/${s.id}`} class="card-parchment rounded-lg p-5 flex items-center gap-4 hover:border-primary-400/40 transition-colors border-accent-rune/30">
              <div class="w-2.5 h-2.5 rounded-full bg-accent-rune animate-pulse shrink-0" aria-hidden="true" />
              <div class="flex-1 min-w-0">
                <p class="font-heading text-base text-neutral-200 tracking-wide">{s.nom || 'Session'}</p>
                <p class="font-body text-xs text-neutral-500">Hôte : {s.expand?.id_hote?.pseudo ?? s.expand?.id_hote?.nom ?? '—'}</p>
              </div>
              <StatusBadge variant="visited" class="px-2 py-1 rounded shrink-0">En cours</StatusBadge>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Planifiées -->
    {planifie.length > 0 && (
      <section>
        <h3 class="font-heading text-xs text-primary-500 tracking-widest uppercase mb-4">Planifiées</h3>
        <div class="flex flex-col gap-3">
          {planifie.map(s => (
            <a href={`/session/${s.id}`} class="card-parchment rounded-lg p-5 flex items-center gap-4 hover:border-primary-400/40 transition-colors">
              <div class="flex-1 min-w-0">
                <p class="font-heading text-base text-neutral-200 tracking-wide">{s.nom || 'Session'}</p>
                {s.date_heur_depart && (
                  <p class="font-body text-xs text-neutral-500">
                    {new Date(s.date_heur_depart).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' })}
                  </p>
                )}
                <p class="font-body text-xs text-neutral-600 mt-0.5">Hôte : {s.expand?.id_hote?.pseudo ?? s.expand?.id_hote?.nom ?? '—'}</p>
              </div>
              <StatusBadge variant="pending" class="px-2 py-1 rounded shrink-0">Planifiée</StatusBadge>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Terminées -->
    {termine.length > 0 && (
      <section>
        <h3 class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-4">Terminées</h3>
        <div class="flex flex-col gap-3">
          {termine.slice(0, 5).map(s => (
            <a href={`/session/${s.id}`} class="card-parchment rounded-lg p-4 flex items-center gap-4 hover:border-primary-400/40 transition-colors opacity-50">
              <div class="flex-1 min-w-0">
                <p class="font-heading text-sm text-neutral-300 tracking-wide">{s.nom || 'Session'}</p>
                {s.date_heur_depart && (
                  <p class="font-body text-xs text-neutral-600">{new Date(s.date_heur_depart).toLocaleDateString('fr-FR', { day:'numeric', month:'long' })}</p>
                )}
              </div>
              <span class="font-heading text-xs text-neutral-600 tracking-widest uppercase">Terminée</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {mySessions.length === 0 && pendingSessions.length === 0 && (
      <div class="card-parchment rounded-xl overflow-hidden text-center">
        <div class="h-48 relative overflow-hidden">
          <Image src={barque} alt="" width={800} height={192} class="w-full h-full object-cover opacity-50" />
          <div class="absolute inset-0 bg-linear-to-t from-dark-600 via-dark-600/40 to-transparent" />
        </div>
        <div class="p-12 lg:p-16">
          <p class="font-display text-4xl text-primary-700 mb-4">⚔</p>
          <p class="font-heading text-xl text-neutral-300 tracking-wide mb-2">Aucune session</p>
          <p class="font-body text-neutral-500 mb-8">Forgez votre premier barathon avec vos compagnons.</p>
          <a href="/session/creer" class="btn-primary px-8 py-3">Créer une session</a>
        </div>
      </div>
    )}

  </div>
</Layout>
