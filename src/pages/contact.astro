---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import { Image } from 'astro:assets';
import taverne_loin  from '../assets/img/taverne_loin.avif';
import mailIcon      from '../assets/icon/mail.svg';
import pingIcon      from '../assets/icon/ping.svg';
import tempsIcon     from '../assets/icon/Temps.svg';
import bouclierIcon  from '../assets/icon/bouclier.svg';
import arrowIcon     from '../assets/icon/arrow_droite.svg';
import citationIcon  from '../assets/icon/citation.svg';
import waringIcon    from '../assets/icon/waring.svg';

let sent  = false;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const nom     = form.get('nom')?.toString().trim() ?? '';
  const email   = form.get('email')?.toString().trim() ?? '';
  const sujet   = form.get('sujet')?.toString() ?? '';
  const message = form.get('message')?.toString().trim() ?? '';

  if (!nom || !email || !message) {
    error = 'Veuillez remplir tous les champs obligatoires.';
  } else {
    sent = true;
  }
}

const sujets = [
  'Question générale',
  'Problème technique',
  'Partenariat taverne',
  'Signaler un bug',
  'Autre',
];
---
<Layout title="Contact — Ægirhall">

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section class="relative bg-dark-900 overflow-hidden" style="padding-block: clamp(4rem, 7vw, 6rem);">
    <div class="absolute inset-0" aria-hidden="true">
      <Image src={taverne_loin} alt="" width={1440} height={480} class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-linear-to-b from-dark-900/50 via-transparent to-dark-900" />
      <div class="absolute inset-0 bg-linear-to-r from-dark-900/60 via-transparent to-dark-900/60" />
    </div>
    <div class="absolute inset-0 bg-diamond opacity-40 pointer-events-none" aria-hidden="true" />
    <div class="absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-primary-400/20 to-transparent" aria-hidden="true" />
    <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-primary-400/40 to-transparent" aria-hidden="true" />

    <div class="relative z-10 max-w-360 mx-auto px-4 lg:px-20 text-center">
      <p class="font-heading text-primary-700 tracking-rune-widest mb-5 select-none text-2xl" aria-hidden="true">ᚲ</p>
      <h1 class="font-display text-5xl lg:text-7xl text-neutral-100 leading-tight tracking-widest mb-4 title-torch drop-shadow-gold">
        Nous contacter
      </h1>
      <p class="font-heading text-lg lg:text-2xl text-primary-400 tracking-rune-sm mb-5">
        Les Halls d'Ægir vous sont ouverts
      </p>
      <div class="divider-diamond max-w-48 mx-auto mt-4 mb-3"><span /></div>
    </div>
  </section>

  <!-- ── CORPS ──────────────────────────────────────────────── -->
  <div class="max-w-360 mx-auto px-4 lg:px-20 py-12 lg:py-20">

    {sent ? (
      <!-- État succès -->
      <div class="card-parchment rounded-xl p-12 lg:p-20 text-center max-w-2xl mx-auto">
        <div class="w-16 h-16 rounded-full bg-accent-rune/15 border border-accent-rune/40 flex items-center justify-center mx-auto mb-6">
          <span class="text-2xl text-accent-rune">✓</span>
        </div>
        <h2 class="font-heading text-2xl text-neutral-200 tracking-wide mb-3">Message envoyé !</h2>
        <p class="font-body text-lg text-neutral-400 leading-relaxed mb-8">
          Les Jarls ont reçu votre missive. Ils vous répondront dans les brumes du Nord sous 24–48 heures.
        </p>
        <a href="/" class="btn-primary px-8 py-3">Retour à l'accueil</a>
      </div>
    ) : (
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14">

        <!-- ── COLONNE GAUCHE : infos ──────────────────────── -->
        <div class="lg:col-span-2 flex flex-col gap-7">

          <div>
            <h2 class="font-heading text-2xl text-neutral-200 tracking-wide mb-3">Restons en contact</h2>
            <p class="font-body text-base text-neutral-500 leading-relaxed">
              Une question, un partenariat ou simplement l'envie de rejoindre la horde ? Les portes de l'Ægirhall sont ouvertes.
            </p>
          </div>

          <!-- Cartes contact -->
          <div class="flex flex-col gap-3">

            <!-- Email -->
            <div class="card-parchment rounded-xl p-4 flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-400/8 border border-primary-400/15 flex items-center justify-center shrink-0">
                <Image src={mailIcon} alt="" width={18} height={18} class="invert opacity-60" aria-hidden="true" />
              </div>
              <div class="min-w-0">
                <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-0.5">Email</p>
                <p class="font-body text-sm text-neutral-300">contact@aegirhall.fr</p>
              </div>
            </div>

            <!-- Adresse -->
            <div class="card-parchment rounded-xl p-4 flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-400/8 border border-primary-400/15 flex items-center justify-center shrink-0">
                <Image src={pingIcon} alt="" width={18} height={18} class="invert opacity-60" aria-hidden="true" />
              </div>
              <div class="min-w-0">
                <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-0.5">Adresse</p>
                <p class="font-body text-sm text-neutral-300">Montbéliard, Grand Est</p>
              </div>
            </div>

            <!-- Horaires -->
            <div class="card-parchment rounded-xl p-4 flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-400/8 border border-primary-400/15 flex items-center justify-center shrink-0">
                <Image src={tempsIcon} alt="" width={18} height={18} class="invert opacity-60" aria-hidden="true" />
              </div>
              <div class="min-w-0">
                <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-0.5">Disponibilité</p>
                <p class="font-body text-sm text-neutral-300">Réponse sous 24–48 h</p>
              </div>
            </div>

          </div>

          <!-- Rune divider -->
          <div class="rune-divider text-primary-700 text-sm font-heading tracking-rune-wider">ᚠ ᚢ ᚦ</div>

          <!-- Engagement -->
          <div class="card-parchment rounded-xl p-5 border-primary-700/30" style="background: linear-gradient(135deg, rgba(196,154,44,0.05) 0%, rgba(196,154,44,0.02) 100%);">
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-primary-400/10 border border-primary-400/20 flex items-center justify-center shrink-0 mt-0.5">
                <Image src={bouclierIcon} alt="" width={16} height={16} class="invert opacity-70" aria-hidden="true" />
              </div>
              <div>
                <p class="font-heading text-sm text-neutral-200 tracking-wide mb-1.5">Notre engagement</p>
                <p class="font-body text-sm text-neutral-500 leading-relaxed">
                  Vos données ne sont jamais partagées à des tiers. Chaque message est traité avec discrétion par les Jarls d'Ægirhall.
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- ── COLONNE DROITE : formulaire ────────────────── -->
        <div class="lg:col-span-3">
          <div class="card-parchment rounded-xl p-6 lg:p-8">

            <!-- En-tête form -->
            <div class="flex items-center gap-4 mb-7">
              <div class="w-12 h-12 rounded-xl bg-primary-400/10 border border-primary-400/20 flex items-center justify-center shrink-0">
                <Image src={citationIcon} alt="" width={22} height={22} class="invert opacity-70" aria-hidden="true" />
              </div>
              <div>
                <h3 class="font-heading text-lg text-neutral-200 tracking-wide">Envoyer un message</h3>
                <p class="font-body text-sm text-neutral-500">Réponse garantie sous 24–48 heures</p>
              </div>
            </div>

            {error && (
              <div class="mb-6 p-3 rounded-lg bg-accent-blood/15 border border-accent-blood/40 font-body text-sm text-neutral-300 flex items-start gap-2" role="alert">
                <Image src={waringIcon} alt="" width={16} height={16} class="invert mt-0.5 shrink-0 opacity-70" />
                <span>{error}</span>
              </div>
            )}

            <form method="POST" class="flex flex-col gap-5" novalidate>

              <!-- Nom + Email côte à côte -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="label-viking" for="c-nom">Prénom & Nom</label>
                  <input
                    id="c-nom" name="nom" type="text" required
                    placeholder="Erik Thorsson"
                    class="input-viking"
                    autocomplete="name"
                  />
                </div>
                <div>
                  <label class="label-viking" for="c-email">Email</label>
                  <div class="input-wrapper">
                    <Image src={mailIcon} alt="" width={16} height={16} class="input-icon invert opacity-35" aria-hidden="true" />
                    <input
                      id="c-email" name="email" type="email" required
                      placeholder="erik@exemple.com"
                      class="input-viking"
                      autocomplete="email"
                    />
                  </div>
                </div>
              </div>

              <!-- Sujet -->
              <div>
                <label class="label-viking" for="c-sujet">Sujet</label>
                <select id="c-sujet" name="sujet" class="input-viking cursor-pointer">
                  {sujets.map(s => <option value={s}>{s}</option>)}
                </select>
              </div>

              <!-- Message -->
              <div>
                <label class="label-viking" for="c-message">Message</label>
                <textarea
                  id="c-message" name="message" required rows="5"
                  placeholder="Rédigez votre message ici…"
                  class="input-viking resize-none"
                />
              </div>

              <!-- Rune divider -->
              <div class="rune-divider text-dark-500 text-xs font-heading tracking-rune-wider">ᚼ</div>

              <!-- Submit -->
              <button type="submit" class="btn-primary w-full py-4 flex items-center justify-center gap-3">
                <span>Envoyer le message</span>
                <Image src={arrowIcon} alt="" width={16} height={16} class="invert" aria-hidden="true" />
              </button>

            </form>
          </div>
        </div>

      </div>
    )}

  </div>

</Layout>
