---
import Layout from '../layouts/Layout.astro';
import PbImage from '../components/PbImage.astro';
import { Image } from 'astro:assets';
import { getMe, getCollection, getVisitesByUser, updateUser, PB_BASE_URL } from '../js/backend.js';
import tropheeIcon  from '../assets/icon/trophée.svg';
import pingIcon     from '../assets/icon/ping.svg';
import bouclierIcon from '../assets/icon/bouclier.svg';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let updateError    = '';
let updateSuccess  = false;
let passwordError  = '';
let passwordSuccess = false;

if (Astro.request.method === 'POST') {
  const form   = await Astro.request.formData();
  const action = form.get('action')?.toString();

  if (action === 'logout') {
    Astro.cookies.delete('pb_token',     { path: '/' });
    Astro.cookies.delete('pb_user_id',   { path: '/' });
    Astro.cookies.delete('pb_user_name', { path: '/' });
    return Astro.redirect('/LandingPage');
  }

  if (action === 'update') {
    const pseudo      = form.get('pseudo')?.toString().trim() ?? '';
    const nom         = form.get('nom')?.toString().trim() ?? '';
    const prenom      = form.get('prenom')?.toString().trim() ?? '';
    const titre       = form.get('titre')?.toString() ?? '';
    const ville       = form.get('ville')?.toString().trim() ?? '';
    const description = form.get('description')?.toString().trim() ?? '';
    const insta       = form.get('insta')?.toString().trim() ?? '';
    const facbook     = form.get('facbook')?.toString().trim() ?? '';
    const discord     = form.get('discord')?.toString().trim() ?? '';

    const result = await updateUser(userId, { pseudo, nom, prenom, titre, ville, description, insta, facbook, discord }, token);
    if (result?.error) {
      updateError = Object.values(result.error?.data ?? {}).map(v => v?.message).filter(Boolean).join(' ') || result.error?.message || 'Erreur de mise à jour.';
    } else {
      updateSuccess = true;
      if (pseudo) Astro.cookies.set('pb_user_name', pseudo, { path: '/', httpOnly: true, maxAge: 604800 });
    }
  }

  if (action === 'password') {
    const oldPassword     = form.get('oldPassword')?.toString() ?? '';
    const password        = form.get('password')?.toString() ?? '';
    const passwordConfirm = form.get('passwordConfirm')?.toString() ?? '';

    if (password !== passwordConfirm) {
      passwordError = 'Les mots de passe ne correspondent pas.';
    } else if (password.length < 8) {
      passwordError = 'Le mot de passe doit faire au moins 8 caractères.';
    } else {
      const result = await updateUser(userId, { oldPassword, password, passwordConfirm }, token);
      if (result?.error) {
        passwordError = Object.values(result.error?.data ?? {}).map(v => v?.message).filter(Boolean).join(' ') || result.error?.message || 'Erreur de mise à jour.';
      } else {
        passwordSuccess = true;
      }
    }
  }
}

let TITRES = ['écumeur des mers', 'jarl des taverne'];
try {
  const schemaRes = await fetch(`${PB_BASE_URL}/api/collections/users`);
  if (schemaRes.ok) {
    const schema     = await schemaRes.json();
    const titreField = schema.fields?.find(f => f.name === 'titre');
    const vals = titreField?.values ?? titreField?.options?.values;
    if (vals?.length) TITRES = vals;
  }
} catch {}

const [user, bars, visites, allBadges] = await Promise.all([
  getMe(userId, token),
  getCollection('bar', { sort: 'ordre' }),
  getVisitesByUser(userId, token),
  getCollection('badges', { token }),
]);

if (!user) return Astro.redirect('/connexion');

const visitedIds   = visites.map(v => v.bar);
const progression  = bars.length ? Math.round((visitedIds.length / bars.length) * 100) : 0;
const visitedBars  = bars.filter(b => visitedIds.includes(b.id));
const userBadgeIds = user.badges ?? [];
---
<Layout title="Mon Profil">

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section class="relative bg-dark-900 py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-linear-to-b from-dark-900 via-dark-800/60 to-dark-800 pointer-events-none" />
    <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-primary-400/30 to-transparent" />

    <div class="relative max-w-360 mx-auto px-4 lg:px-20 flex flex-col lg:flex-row items-center lg:items-start gap-8">
      <!-- Avatar -->
      <div class="w-24 h-24 lg:w-32 lg:h-32 rounded-full bg-dark-600 border-2 border-primary-400/50 overflow-hidden shrink-0 flex items-center justify-center">
        {user.avatar ? (
          <PbImage record={user} recordImage={user.avatar} width={128} height={128} />
        ) : (
          <span class="font-display text-4xl lg:text-5xl text-primary-400">
            {(user.pseudo ?? user.nom)?.charAt(0)?.toUpperCase() ?? 'V'}
          </span>
        )}
      </div>

      <!-- Infos -->
      <div class="text-center lg:text-left flex-1">
        <p class="font-heading text-primary-500 text-xs tracking-widest uppercase mb-2">{user.titre ?? 'Guerrier'}</p>
        <h1 class="font-display text-3xl lg:text-5xl text-neutral-100 tracking-widest mb-2">{user.pseudo ?? user.nom}</h1>
        <p class="font-body text-neutral-500 text-base">{user.email}</p>
      </div>

      <!-- Progression -->
      <div class="card-parchment rounded-lg p-5 min-w-56 text-center shrink-0">
        <p class="font-display text-4xl text-primary-400 mb-1">{progression}%</p>
        <p class="font-heading text-xs text-neutral-500 tracking-widest uppercase mb-3">Progression</p>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" style={`width:${progression}%`} />
        </div>
        <p class="font-body text-xs text-neutral-600 mt-2">{visitedIds.length} / {bars.length} tavernes</p>
      </div>
    </div>
  </section>

  <!-- ── CONTENU ───────────────────────────────────────────── -->
  <div class="max-w-360 mx-auto px-4 lg:px-20 py-10 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- ── COLONNE PRINCIPALE ──────────────────────────────── -->
      <div class="lg:col-span-2 flex flex-col gap-8">

        <!-- Modifier le profil -->
        <div class="card-parchment rounded-lg p-6">
          <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase mb-6">
            Modifier mon profil
          </h2>

          {updateError && (
            <div class="mb-5 p-3 rounded bg-accent-blood/20 border border-accent-blood/50 text-sm font-body text-neutral-300">
              {updateError}
            </div>
          )}
          {updateSuccess && (
            <div class="mb-5 p-3 rounded bg-accent-rune/20 border border-accent-rune/50 text-sm font-body text-neutral-300">
              Profil mis à jour avec succès.
            </div>
          )}

          <form method="POST" class="flex flex-col gap-5">
            <input type="hidden" name="action" value="update" />

            <!-- Identité -->
            <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase border-b border-dark-600 pb-2">Identité</p>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div>
                <label class="label-viking" for="pseudo">Pseudo *</label>
                <input id="pseudo" name="pseudo" type="text" required value={user.pseudo ?? ''} class="input-viking" placeholder="Nom d'affichage" />
              </div>
              <div>
                <label class="label-viking" for="titre">Titre Viking</label>
                <select id="titre" name="titre" class="input-viking cursor-pointer">
                  {TITRES.map(t => (
                    <option value={t} selected={user.titre === t}>{t}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="label-viking" for="prenom">Prénom</label>
                <input id="prenom" name="prenom" type="text" value={user.prenom ?? ''} class="input-viking" placeholder="Votre prénom" />
              </div>
              <div>
                <label class="label-viking" for="nom">Nom</label>
                <input id="nom" name="nom" type="text" value={user.nom ?? ''} class="input-viking" placeholder="Votre nom" />
              </div>
              <div>
                <label class="label-viking" for="ville">Ville</label>
                <input id="ville" name="ville" type="text" value={user.ville ?? ''} class="input-viking" placeholder="Votre ville" />
              </div>
            </div>

            <!-- Bio -->
            <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase border-b border-dark-600 pb-2 mt-2">Bio</p>
            <div>
              <label class="label-viking" for="description">Description</label>
              <textarea id="description" name="description" rows="3" class="input-viking resize-none" placeholder="Votre légende en quelques mots...">{user.description ?? ''}</textarea>
            </div>

            <!-- Réseaux -->
            <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase border-b border-dark-600 pb-2 mt-2">Réseaux sociaux</p>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
              <div>
                <label class="label-viking" for="insta">Instagram</label>
                <input id="insta" name="insta" type="text" value={user.insta ?? ''} class="input-viking" placeholder="@votre_compte" />
              </div>
              <div>
                <label class="label-viking" for="facbook">Facebook</label>
                <input id="facbook" name="facbook" type="text" value={user.facbook ?? ''} class="input-viking" placeholder="Votre profil" />
              </div>
              <div>
                <label class="label-viking" for="discord">Discord</label>
                <input id="discord" name="discord" type="text" value={user.discord ?? ''} class="input-viking" placeholder="pseudo#0000" />
              </div>
            </div>

            <button type="submit" class="btn-primary py-3 mt-2">
              Sauvegarder les modifications
            </button>
          </form>
        </div>

        <!-- Changer de mot de passe -->
        <div class="card-parchment rounded-lg p-6">
          <h2 class="font-heading text-base text-primary-500 tracking-widest uppercase mb-6">
            Changer de mot de passe
          </h2>

          {passwordError && (
            <div class="mb-5 p-3 rounded bg-accent-blood/20 border border-accent-blood/50 text-sm font-body text-neutral-300">
              {passwordError}
            </div>
          )}
          {passwordSuccess && (
            <div class="mb-5 p-3 rounded bg-accent-rune/20 border border-accent-rune/50 text-sm font-body text-neutral-300">
              Mot de passe modifié avec succès.
            </div>
          )}

          <form method="POST" class="flex flex-col gap-4">
            <input type="hidden" name="action" value="password" />
            <div>
              <label class="label-viking" for="oldPassword">Mot de passe actuel</label>
              <input id="oldPassword" name="oldPassword" type="password" required class="input-viking" placeholder="••••••••" autocomplete="current-password" />
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div>
                <label class="label-viking" for="password">Nouveau mot de passe</label>
                <input id="password" name="password" type="password" required class="input-viking" placeholder="8 caractères minimum" autocomplete="new-password" />
              </div>
              <div>
                <label class="label-viking" for="passwordConfirm">Confirmer</label>
                <input id="passwordConfirm" name="passwordConfirm" type="password" required class="input-viking" placeholder="••••••••" autocomplete="new-password" />
              </div>
            </div>
            <button type="submit" class="btn-outline py-3 mt-1">
              Changer le mot de passe
            </button>
          </form>
        </div>

        <!-- Tavernes Conquises -->
        <div>
          <h2 class="font-heading text-xl text-neutral-200 tracking-wide mb-6 flex items-center gap-2">
            <Image src={pingIcon} alt="" width={20} height={20} class="invert opacity-70" />
            Tavernes Conquises
          </h2>
          {visitedBars.length > 0 ? (
            <div class="flex flex-col gap-3">
              {visitedBars.map(bar => {
                const visite = visites.find(v => v.bar === bar.id);
                return (
                  <a
                    href={`/bars/${bar.id}`}
                    class="card-parchment rounded-lg p-4 flex items-center gap-4 hover:border-primary-400/40 transition-colors"
                  >
                    <span class="w-8 h-8 rounded-full bg-accent-rune/20 border border-accent-rune/40 flex items-center justify-center font-heading text-sm text-green-400 shrink-0">
                      {bar.ordre}
                    </span>
                    <div class="flex-1 min-w-0">
                      <p class="font-heading text-sm text-neutral-200 tracking-wide">{bar.nom}</p>
                      {visite?.created && (
                        <p class="font-body text-xs text-neutral-600 mt-0.5">
                          {new Date(visite.created).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                        </p>
                      )}
                    </div>
                    <span class="badge-visited text-xs font-heading tracking-widest uppercase px-2 py-0.5 rounded shrink-0">⚔</span>
                  </a>
                );
              })}
            </div>
          ) : (
            <div class="card-parchment rounded-lg p-8 text-center">
              <p class="font-body text-neutral-500">Votre légende commence maintenant. La première taverne vous attend.</p>
              <a href="/bars" class="btn-primary mt-4 inline-block">Voir la route</a>
            </div>
          )}
        </div>

      </div>

      <!-- ── SIDEBAR ─────────────────────────────────────────── -->
      <div class="flex flex-col gap-6">

        <!-- Statistiques -->
        <div class="card-parchment rounded-lg p-5">
          <p class="font-heading text-xs text-primary-500 tracking-widest uppercase mb-4 flex items-center gap-1.5">
            <Image src={tropheeIcon} alt="" width={14} height={14} class="invert opacity-60" />
            Statistiques
          </p>
          <div class="flex flex-col gap-4">
            {[
              { label: 'Tavernes visitées',  val: visitedIds.length },
              { label: 'Tavernes restantes', val: bars.length - visitedIds.length },
              { label: 'Badges obtenus',     val: userBadgeIds.length },
            ].map(stat => (
              <div class="flex justify-between items-center">
                <span class="font-body text-neutral-400 text-base">{stat.label}</span>
                <span class="font-heading text-lg text-primary-400">{stat.val}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Badges -->
        <div>
          <h2 class="font-heading text-base text-neutral-200 tracking-wide mb-4 flex items-center gap-2">
            <Image src={bouclierIcon} alt="" width={18} height={18} class="invert opacity-70" />
            Badges
          </h2>
          {allBadges.length > 0 ? (
            <div class="grid grid-cols-2 gap-3">
              {allBadges.map(badge => {
                const isOwned = userBadgeIds.includes(badge.id);
                return (
                  <div class={`card-parchment rounded-lg p-4 text-center transition-opacity ${isOwned ? '' : 'opacity-30'}`}>
                    {badge.img ? (
                      <div class="w-12 h-12 rounded-full mx-auto mb-2 overflow-hidden bg-dark-700">
                        <PbImage record={badge} recordImage={badge.img} width={48} height={48} />
                      </div>
                    ) : (
                      <span class="text-2xl block mb-2">{isOwned ? '⚔' : '○'}</span>
                    )}
                    <p class="font-heading text-xs text-neutral-200 tracking-wide mb-1 leading-snug">{badge.nom}</p>
                    {isOwned && (
                      <span class="badge-visited text-xs font-heading tracking-widest uppercase px-2 py-0.5 rounded inline-block mt-1">Obtenu</span>
                    )}
                  </div>
                );
              })}
            </div>
          ) : (
            <p class="font-body text-neutral-600 text-sm">Aucun badge disponible.</p>
          )}
        </div>

        <!-- Actions rapides -->
        <div class="flex flex-col gap-3">
          <a href="/bars" class="btn-primary text-sm text-center py-3">Continuer la Route</a>
          <a href="/classement" class="btn-outline text-sm text-center py-3">Voir le Classement</a>
        </div>

        <!-- Déconnexion -->
        <form method="POST" class="mt-2">
          <input type="hidden" name="action" value="logout" />
          <button type="submit" class="w-full font-heading text-xs text-neutral-600 hover:text-accent-blood tracking-widest uppercase py-2 transition-colors">
            Se déconnecter
          </button>
        </form>

      </div>
    </div>
  </div>

</Layout>
