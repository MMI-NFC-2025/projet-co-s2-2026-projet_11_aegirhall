---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getMe, updateUser } from '../js/backend.js';
import couroneIcon  from '../assets/icon/courone.svg';
import bouclierIcon from '../assets/icon/bouclier.svg';
import eclaireIcon  from '../assets/icon/eclaire.svg';
import tropheeIcon  from '../assets/icon/trophée.svg';
import StatusBadge  from '../components/StatusBadge.astro';
import medailIcon   from '../assets/icon/medail.svg';
import bierreIcon   from '../assets/icon/bierre.svg';
import personnesIcon from '../assets/icon/personnes.svg';
import carteIcon    from '../assets/icon/carte.svg';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let success = '';
let error   = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const plan = form.get('plan')?.toString();
  if (plan === 'gratuit' || plan === 'premium') {
    const res = await updateUser(userId, { abonnements: plan }, token);
    if (res?.error) {
      error = res.error?.message ?? 'Erreur lors de la mise à jour.';
    } else {
      success = plan === 'premium' ? 'Bienvenue dans le clan des Jarls !' : 'Abonnement repassé en Gratuit.';
    }
  }
}

const me = await getMe(userId, token);
const currentPlan = me?.abonnements ?? 'gratuit';
const isPremium   = currentPlan === 'premium';
---
<Layout title="Abonnement — AEgirhall">

  <!-- ── HERO ──────────────────────────────────────────── -->
  <section class="bg-dark-900 border-b border-dark-700 py-10 lg:py-16 relative overflow-hidden">
    <!-- Déco fond -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-primary-400/4 blur-3xl" />
    </div>
    <div class="max-w-360 mx-auto px-4 lg:px-20 text-center relative">
      <div class="inline-flex items-center gap-2 bg-primary-400/10 border border-primary-400/25 rounded-full px-4 py-1.5 mb-6">
        <Image src={couroneIcon} alt="" width={14} height={14} class="invert opacity-80" aria-hidden="true" />
        <span class="font-heading text-xs text-primary-300 tracking-widest uppercase">Rang & Privilèges</span>
      </div>
      <h1 class="font-display text-3xl lg:text-5xl text-neutral-100 tracking-widest mb-4">Choisissez votre Clan</h1>
      <p class="font-body text-base lg:text-lg text-neutral-500 max-w-xl mx-auto">
        Rejoignez le clan des Jarls et débloquez tous les privilèges de la taverne.
      </p>
      {success && (
        <div class="mt-6 inline-flex items-center gap-2 bg-accent-rune/15 border border-accent-rune/40 rounded-lg px-5 py-3">
          <span class="text-green-400 text-sm">✓</span>
          <span class="font-heading text-sm text-green-300 tracking-wide">{success}</span>
        </div>
      )}
      {error && (
        <div class="mt-6 inline-flex items-center gap-2 bg-accent-blood/15 border border-accent-blood/40 rounded-lg px-5 py-3">
          <span class="font-body text-sm text-neutral-300">{error}</span>
        </div>
      )}
    </div>
  </section>

  <!-- ── PLANS ──────────────────────────────────────────── -->
  <section class="max-w-360 mx-auto px-4 lg:px-20 py-12 lg:py-16">

    <!-- Badge plan actuel -->
    <div class="text-center mb-10">
      <span class={`inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-heading tracking-widest uppercase border ${isPremium ? 'bg-primary-400/15 border-primary-400/40 text-primary-300' : 'bg-dark-700 border-dark-600 text-neutral-500'}`}>
        {isPremium
          ? <><Image src={couroneIcon} alt="" width={12} height={12} class="invert opacity-80" />Plan actuel : Jarl Premium</>
          : 'Plan actuel : Guerrier Gratuit'
        }
      </span>
    </div>

    <!-- Cards plans -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-3xl mx-auto">

      <!-- ── GRATUIT ── -->
      <div class={`card-parchment rounded-2xl p-7 flex flex-col gap-5 relative ${!isPremium ? 'border-primary-400/30' : ''}`}>
        {!isPremium && (
          <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <StatusBadge class="px-3 py-1 rounded-full">Plan actuel</StatusBadge>
          </div>
        )}
        <div>
          <p class="font-heading text-xs text-neutral-600 tracking-widest uppercase mb-1">Pour commencer</p>
          <h2 class="font-display text-2xl text-neutral-200 tracking-wide">Guerrier</h2>
          <p class="font-body text-sm text-neutral-500 mt-1">L'accès de base à la taverne</p>
        </div>
        <div class="flex items-end gap-1">
          <span class="font-display text-4xl text-neutral-100">0 €</span>
          <span class="font-body text-sm text-neutral-600 mb-1">/mois</span>
        </div>
        <ul class="flex flex-col gap-3 font-body text-sm text-neutral-400 flex-1">
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-rune/20 text-green-400 flex items-center justify-center text-xs shrink-0">✓</span>
            Accès à la carte des tavernes
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-rune/20 text-green-400 flex items-center justify-center text-xs shrink-0">✓</span>
            Création de sessions (3 max)
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-rune/20 text-green-400 flex items-center justify-center text-xs shrink-0">✓</span>
            Classement général
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-rune/20 text-green-400 flex items-center justify-center text-xs shrink-0">✓</span>
            Profil guerrier de base
          </li>
          <li class="flex items-center gap-3 opacity-40">
            <span class="w-5 h-5 rounded-full bg-dark-600 flex items-center justify-center text-xs shrink-0 text-neutral-600">✕</span>
            Badge Jarl Premium
          </li>
          <li class="flex items-center gap-3 opacity-40">
            <span class="w-5 h-5 rounded-full bg-dark-600 flex items-center justify-center text-xs shrink-0 text-neutral-600">✕</span>
            Sessions illimitées
          </li>
          <li class="flex items-center gap-3 opacity-40">
            <span class="w-5 h-5 rounded-full bg-dark-600 flex items-center justify-center text-xs shrink-0 text-neutral-600">✕</span>
            Statistiques avancées
          </li>
        </ul>
        {isPremium ? (
          <form method="POST">
            <input type="hidden" name="plan" value="gratuit" />
            <button type="submit"
              class="w-full py-3 font-heading text-sm tracking-widest uppercase text-neutral-600 border border-dark-600 rounded hover:border-neutral-600 hover:text-neutral-400 transition-colors">
              Rétrograder
            </button>
          </form>
        ) : (
          <div class="py-3 font-heading text-sm tracking-widest uppercase text-center text-neutral-600">
            Plan actuel
          </div>
        )}
      </div>

      <!-- ── PREMIUM ── -->
      <div class={`relative rounded-2xl p-7 flex flex-col gap-5 overflow-hidden bg-card-premium ${isPremium ? 'border-2 border-primary-400/60' : 'border border-primary-400/30'}`}>
        <!-- Lueur dorée -->
        <div class="absolute top-0 right-0 w-40 h-40 bg-primary-400/8 rounded-full blur-2xl pointer-events-none" aria-hidden="true" />

        {isPremium && (
          <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <span class="bg-primary-400 text-dark-900 text-xs font-heading tracking-widest uppercase px-3 py-1 rounded-full">Plan actuel</span>
          </div>
        )}
        {!isPremium && (
          <div class="absolute top-4 right-4">
            <span class="bg-primary-400/20 border border-primary-400/40 text-primary-300 text-xs font-heading tracking-widest uppercase px-2 py-0.5 rounded-full">Populaire</span>
          </div>
        )}

        <div>
          <p class="font-heading text-xs text-primary-500 tracking-widest uppercase mb-1">Accès complet</p>
          <div class="flex items-center gap-2">
            <h2 class="font-display text-2xl text-primary-300 tracking-wide">Jarl</h2>
            <Image src={couroneIcon} alt="" width={20} height={20} class="invert opacity-70" aria-hidden="true" />
          </div>
          <p class="font-body text-sm text-neutral-500 mt-1">Tous les privilèges de la grande salle</p>
        </div>
        <div class="flex items-end gap-1">
          <span class="font-display text-4xl text-primary-300">4,99 €</span>
          <span class="font-body text-sm text-neutral-600 mb-1">/mois</span>
        </div>
        <ul class="flex flex-col gap-3 font-body text-sm text-neutral-400 flex-1">
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-rune/20 text-green-400 flex items-center justify-center text-xs shrink-0">✓</span>
            Tout le plan Guerrier
          </li>
          <li class="flex items-center gap-3 text-neutral-200">
            <span class="w-5 h-5 rounded-full bg-primary-400/20 text-primary-300 flex items-center justify-center shrink-0">
              <Image src={couroneIcon} alt="" width={10} height={10} class="invert opacity-80" />
            </span>
            Badge Jarl sur votre profil
          </li>
          <li class="flex items-center gap-3 text-neutral-200">
            <span class="w-5 h-5 rounded-full bg-primary-400/20 text-primary-300 flex items-center justify-center shrink-0">
              <Image src={bierreIcon} alt="" width={10} height={10} class="invert opacity-80" />
            </span>
            Sessions illimitées
          </li>
          <li class="flex items-center gap-3 text-neutral-200">
            <span class="w-5 h-5 rounded-full bg-primary-400/20 text-primary-300 flex items-center justify-center shrink-0">
              <Image src={tropheeIcon} alt="" width={10} height={10} class="invert opacity-80" />
            </span>
            Statistiques avancées
          </li>
          <li class="flex items-center gap-3 text-neutral-200">
            <span class="w-5 h-5 rounded-full bg-primary-400/20 text-primary-300 flex items-center justify-center shrink-0">
              <Image src={personnesIcon} alt="" width={10} height={10} class="invert opacity-80" />
            </span>
            Amis illimités
          </li>
          <li class="flex items-center gap-3 text-neutral-200">
            <span class="w-5 h-5 rounded-full bg-primary-400/20 text-primary-300 flex items-center justify-center shrink-0">
              <Image src={bouclierIcon} alt="" width={10} height={10} class="invert opacity-80" />
            </span>
            Support prioritaire
          </li>
        </ul>
        {!isPremium ? (
          <form method="POST">
            <input type="hidden" name="plan" value="premium" />
            <button type="submit" class="btn-primary w-full py-3.5 text-sm">
              ⚔ Rejoindre le clan des Jarls
            </button>
          </form>
        ) : (
          <div class="py-3 font-heading text-sm tracking-widest uppercase text-center text-primary-500">
            ✓ Abonnement actif
          </div>
        )}
      </div>
    </div>

    <!-- ── AVANTAGES DÉTAILLÉS (Premium) ──────────────────── -->
    <div class="mt-16">
      <div class="text-center mb-8">
        <h2 class="font-heading text-lg text-neutral-300 tracking-widest uppercase">Pourquoi rejoindre le clan des Jarls ?</h2>
        <div class="w-16 h-px bg-primary-400/40 mx-auto mt-3" />
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 max-w-4xl mx-auto">

        <div class="card-parchment rounded-xl p-5 flex flex-col items-center text-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-primary-400/10 border border-primary-400/20 flex items-center justify-center">
            <Image src={eclaireIcon} alt="" width={20} height={20} class="invert opacity-70" aria-hidden="true" />
          </div>
          <h3 class="font-heading text-sm text-neutral-200 tracking-wide">Sessions illimitées</h3>
          <p class="font-body text-xs text-neutral-500">Organisez autant de barathons que vous voulez, sans restriction.</p>
        </div>

        <div class="card-parchment rounded-xl p-5 flex flex-col items-center text-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-primary-400/10 border border-primary-400/20 flex items-center justify-center">
            <Image src={medailIcon} alt="" width={20} height={20} class="invert opacity-70" aria-hidden="true" />
          </div>
          <h3 class="font-heading text-sm text-neutral-200 tracking-wide">Badge Jarl exclusif</h3>
          <p class="font-body text-xs text-neutral-500">Affichez votre statut de Jarl avec un badge doré sur votre profil.</p>
        </div>

        <div class="card-parchment rounded-xl p-5 flex flex-col items-center text-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-primary-400/10 border border-primary-400/20 flex items-center justify-center">
            <Image src={carteIcon} alt="" width={20} height={20} class="invert opacity-70" aria-hidden="true" />
          </div>
          <h3 class="font-heading text-sm text-neutral-200 tracking-wide">Statistiques avancées</h3>
          <p class="font-body text-xs text-neutral-500">Suivez vos exploits, vos tavernes conquises et vos scores en détail.</p>
        </div>

      </div>
    </div>

    <!-- ── FAQ ────────────────────────────────────────────── -->
    <div class="mt-16 max-w-2xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="font-heading text-lg text-neutral-300 tracking-widest uppercase">Questions fréquentes</h2>
        <div class="w-16 h-px bg-primary-400/40 mx-auto mt-3" />
      </div>
      <div class="flex flex-col gap-3">
        {[
          {
            q: 'Comment fonctionne l\'abonnement Premium ?',
            a: 'Une fois activé, tous les avantages Jarl sont immédiatement disponibles sur votre compte. Vous pouvez rétrograder à tout moment.'
          },
          {
            q: 'Puis-je annuler à tout moment ?',
            a: 'Oui, vous pouvez repasser en Gratuit à tout moment depuis cette page. Aucun engagement ni frais cachés.'
          },
          {
            q: 'Le plan Gratuit est-il vraiment gratuit ?',
            a: 'Oui, le plan Guerrier reste gratuit à vie. Il donne accès aux fonctionnalités essentielles de la taverne.'
          },
        ].map(({ q, a }) => (
          <details class="card-parchment rounded-xl group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none font-heading text-sm text-neutral-300 tracking-wide hover:text-neutral-100 transition-colors">
              {q}
              <span class="text-primary-400 text-base transition-transform group-open:rotate-45 shrink-0 ml-3">+</span>
            </summary>
            <p class="px-5 pb-4 font-body text-sm text-neutral-500 leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>

  </section>

</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
