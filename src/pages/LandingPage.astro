---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vegvisir from '../assets/icon/vegvisir.svg';
import valknut  from '../assets/icon/valknut.svg';
import { getCollection } from '../js/backend.js';

const token = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (token && userId) return Astro.redirect('/');

const bars       = await getCollection('bars', { sort: 'ordre', perPage: 3 });
const totalBars  = bars.length;
const totalUsers = (await getCollection('users', { perPage: 200, fields: 'id' })).length || 0;
---
<Layout title="La Route des Jarls" description="Le grand barathon viking — parcourez la Route des Jarls et conquérez chaque taverne.">

  <!-- ══════════════════════════════════════════════════════
       HERO — PLEIN ÉCRAN ATMOSPHÉRIQUE
       ══════════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden bg-dark-900">

    <!-- Couche 1 — texture losanges -->
    <div class="absolute inset-0 bg-diamond pointer-events-none" aria-hidden="true" />

    <!-- Couche 2 — torchlight radial gold -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(196,154,44,0.10) 0%, rgba(160,120,32,0.05) 40%, transparent 70%);"
      aria-hidden="true"
    />

    <!-- Couche 3 — vignette noire sur les bords -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 90% 90% at 50% 50%, transparent 40%, rgba(4,12,22,0.8) 100%);"
      aria-hidden="true"
    />

    <!-- Vegvísir décoratif — arrière-plan, très grande taille -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none" aria-hidden="true">
      <Image
        src={vegvisir}
        alt=""
        width={700}
        height={700}
        class="opacity-[0.04]"
        style="color:#C49A2C;"
      />
    </div>

    <!-- Runes verticales — côtés (desktop uniquement) -->
    <div class="absolute left-6 top-1/2 -translate-y-1/2 hidden lg:flex flex-col gap-4 pointer-events-none select-none" aria-hidden="true">
      {'ᚠᚢᚦᚨᚱᚲᚷᚹᚺᚾᛁᛃᛇᛈᛉᛊᛏᛒᛖᛗᛚᛜᛞᛟ'.split('').map(r => (
        <span class="font-heading text-xs text-primary-800 tracking-widest">{r}</span>
      ))}
    </div>
    <div class="absolute right-6 top-1/2 -translate-y-1/2 hidden lg:flex flex-col gap-4 pointer-events-none select-none" aria-hidden="true">
      {'ᛟᛞᛜᛚᛗᛖᛒᛏᛊᛉᛈᛇᛃᛁᚾᚺᚹᚷᚲᚱᚨᚦᚢᚠ'.split('').map(r => (
        <span class="font-heading text-xs text-primary-800 tracking-widest">{r}</span>
      ))}
    </div>

    <!-- Contenu principal -->
    <div class="relative z-10 px-4 lg:px-20 max-w-360 mx-auto w-full">

      <!-- Eyebrow -->
      <p class="font-heading text-primary-500 text-xs tracking-[0.35em] uppercase mb-6 lg:mb-8">
        ✦ &nbsp; Barathon Viking &nbsp; ✦
      </p>

      <!-- Titre principal avec shimmer -->
      <h1 class="title-shimmer font-display text-6xl lg:text-[120px] leading-none tracking-widest mb-3 lg:mb-5">
        Ægirhall
      </h1>

      <!-- Sous-titre -->
      <p class="font-heading text-xl lg:text-3xl text-primary-300 tracking-[0.15em] mb-6 lg:mb-8">
        La Route des Jarls
      </p>

      <!-- Divider runique -->
      <div class="divider-diamond max-w-xs mx-auto mb-6 lg:mb-8">
        <span />
      </div>

      <!-- Description -->
      <p class="font-body text-lg lg:text-xl text-neutral-400 max-w-xl mx-auto leading-relaxed mb-10 lg:mb-14">
        Parcourez les tavernes de la horde, levez votre corne de miel et gravez votre nom dans les runes du classement éternel.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16 lg:mb-20">
        <a href="/inscription" class="btn-primary text-sm lg:text-base px-10 py-5">
          Rejoindre la Horde
        </a>
        <a href="/connexion" class="btn-outline text-sm lg:text-base px-10 py-5">
          Se Connecter
        </a>
      </div>

      <!-- Stats — cadres runiques -->
      <div class="flex flex-col sm:flex-row gap-6 lg:gap-20 justify-center items-center">
        {[
          { value: totalBars  || '?', label: 'Tavernes', rune: 'ᚦ' },
          { value: totalUsers || '?', label: 'Guerriers', rune: 'ᚢ' },
          { value: '1',               label: 'Route Légendaire', rune: 'ᚱ' },
        ].map(stat => (
          <div class="frame-rune text-center min-w-28">
            <p class="font-heading text-primary-700 text-base mb-1 tracking-widest">{stat.rune}</p>
            <p class="font-display text-4xl lg:text-5xl text-primary-400 mb-1 text-glow">{stat.value}</p>
            <p class="font-heading text-xs text-neutral-600 tracking-[0.2em] uppercase">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bordure basse dorée -->
    <div class="absolute bottom-0 left-0 right-0">
      <div class="h-px bg-linear-to-r from-transparent via-primary-400/50 to-transparent" />
      <div class="h-px bg-linear-to-r from-transparent via-primary-600/20 to-transparent mt-1" />
    </div>

    <!-- Indicateur de scroll -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-heading text-xs text-neutral-500 tracking-[0.3em] uppercase">Découvrir</span>
      <svg class="w-4 h-4 text-primary-600 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       LE RITUEL — COMMENT ÇA MARCHE
       ══════════════════════════════════════════════════════ -->
  <section class="relative py-24 lg:py-36 bg-dark-800 bg-mesh-gold overflow-hidden">
    <!-- Valknut décoratif en coin -->
    <div class="absolute -right-16 top-1/2 -translate-y-1/2 pointer-events-none select-none hidden lg:block" aria-hidden="true">
      <Image src={valknut} alt="" width={320} height={320} class="opacity-[0.04]" style="color:#C49A2C;" />
    </div>

    <div class="max-w-360 mx-auto px-4 lg:px-20 relative z-10">
      <!-- En-tête section -->
      <div class="text-center mb-14 lg:mb-20">
        <p class="font-heading text-primary-600 text-xs tracking-[0.35em] uppercase mb-4">
          ᚦ &nbsp; Le Rituel &nbsp; ᚦ
        </p>
        <h2 class="font-heading text-3xl lg:text-5xl text-neutral-200 tracking-wide mb-5">
          Comment ça marche
        </h2>
        <div class="divider-diamond max-w-48 mx-auto"><span /></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">
        {[
          {
            num: 'I', rune: 'ᚠ',
            titre: 'Rejoindre la Horde',
            desc: 'Créez votre compte, choisissez votre titre viking et rejoignez les guerriers qui arpentent déjà la route.'
          },
          {
            num: 'II', rune: 'ᚢ',
            titre: 'Parcourir les Tavernes',
            desc: 'Suivez la Route des Jarls, visitez chaque taverne dans l\'ordre et marquez votre passage dans les runes.'
          },
          {
            num: 'III', rune: 'ᚱ',
            titre: 'Gravez Votre Légende',
            desc: 'Montez dans le classement éternel, débloquez vos titres de guerre et devenez un Jarl de la Horde.'
          },
        ].map((step, i) => (
          <div class={`card-parchment card-hover rounded-lg p-8 text-center relative overflow-hidden ${i === 1 ? 'lg:mt-6' : ''}`}>
            <!-- Rune de fond -->
            <span class="absolute top-3 right-4 font-heading text-5xl text-primary-900 pointer-events-none select-none" aria-hidden="true">
              {step.rune}
            </span>
            <!-- Numéro romain -->
            <div class="w-16 h-16 rounded-full border border-primary-400/30 flex items-center justify-center mx-auto mb-5 relative">
              <span class="font-display text-2xl text-primary-400">{step.num}</span>
              <!-- Cercle animé -->
              <div class="absolute inset-0 rounded-full border border-primary-400/10 scale-110 animate-pulse" />
            </div>
            <h3 class="font-heading text-base text-neutral-200 tracking-wide mb-3">{step.titre}</h3>
            <p class="font-body text-base text-neutral-500 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       APERÇU DES TAVERNES
       ══════════════════════════════════════════════════════ -->
  {bars.length > 0 && (
    <section class="relative py-24 lg:py-36 bg-dark-900 overflow-hidden">
      <!-- Vegvísir en fond à gauche -->
      <div class="absolute -left-20 top-1/2 -translate-y-1/2 pointer-events-none select-none hidden lg:block" aria-hidden="true">
        <Image src={vegvisir} alt="" width={400} height={400} class="opacity-[0.035]" style="color:#C49A2C;" />
      </div>

      <div class="max-w-360 mx-auto px-4 lg:px-20 relative z-10">
        <div class="text-center mb-14 lg:mb-18">
          <p class="font-heading text-primary-600 text-xs tracking-[0.35em] uppercase mb-4">
            ᚲ &nbsp; Le Parcours &nbsp; ᚲ
          </p>
          <h2 class="font-heading text-3xl lg:text-5xl text-neutral-200 tracking-wide mb-5">
            Les Premières Tavernes
          </h2>
          <div class="divider-diamond max-w-48 mx-auto"><span /></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 mb-12">
          {bars.map((bar, i) => (
            <div class="card-parchment card-hover rounded-lg overflow-hidden group relative">
              <!-- Image placeholder avec numéro d'étape -->
              <div class="h-52 bg-linear-to-b from-dark-700 to-dark-800 relative overflow-hidden flex items-center justify-center">
                <span class="font-display text-6xl text-primary-900 select-none">{i + 1}</span>
                <div class="absolute inset-0 bg-linear-to-t from-dark-900/90 to-transparent" />
                <span class="absolute top-3 left-3 font-heading text-xs text-primary-400 tracking-widest uppercase bg-dark-900/80 px-3 py-1 rounded border border-primary-400/20">
                  Étape {bar.ordre}
                </span>
              </div>
              <div class="p-6">
                <h3 class="font-heading text-lg text-neutral-200 tracking-wide mb-2 group-hover:text-primary-300 transition-colors">
                  {bar.nom}
                </h3>
                <p class="font-body text-sm text-neutral-600 mb-3">{bar.adresse}</p>
                {bar.specialite && (
                  <p class="font-heading text-xs text-primary-500 tracking-wide uppercase">{bar.specialite}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="text-center">
          <p class="font-body text-neutral-500 mb-6">Inscrivez-vous pour voir la route complète</p>
          <a href="/inscription" class="btn-primary px-10 py-4">Voir toute la route</a>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════════════
       CTA FINAL — APPEL AUX ARMES
       ══════════════════════════════════════════════════════ -->
  <section class="relative py-24 lg:py-40 text-center overflow-hidden bg-dark-900">
    <!-- Torchlight central -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(196,154,44,0.08) 0%, transparent 60%);"
      aria-hidden="true"
    />
    <div class="absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-primary-400/40 to-transparent" />
    <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-primary-400/30 to-transparent" />

    <div class="relative z-10 max-w-360 mx-auto px-4 lg:px-20">
      <p class="font-heading text-primary-700 text-xs tracking-[0.35em] uppercase mb-6">
        ᚨ &nbsp; L'Heure est Venue &nbsp; ᚨ
      </p>
      <h2 class="font-display text-4xl lg:text-7xl text-neutral-100 tracking-widest mb-6 lg:mb-8 title-torch">
        Prêt à entrer<br class="hidden lg:block" /> dans la légende ?
      </h2>
      <div class="divider-diamond max-w-xs mx-auto mb-8"><span /></div>
      <p class="font-body text-lg lg:text-xl text-neutral-400 max-w-xl mx-auto mb-12 leading-relaxed">
        Les Nornes ont tracé votre destin. Il ne vous reste plus qu'à saisir votre corne de miel et partir à la conquête des tavernes.
      </p>
      <a href="/inscription" class="btn-primary text-base px-12 py-6">
        Forger ma Légende
      </a>
    </div>
  </section>

</Layout>
